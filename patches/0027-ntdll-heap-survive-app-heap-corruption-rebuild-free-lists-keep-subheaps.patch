+static BOOL release_empty_subheaps(void)
+{
+    static int release = -1;
+
+    if (release < 0)
+    {
+        WCHAR buffer[8];
+        UNICODE_STRING name = RTL_CONSTANT_STRING( L"WINE_HEAP_RELEASE_SUBHEAPS" ), value;
+
+        value.Buffer = buffer;
+        value.MaximumLength = sizeof(buffer);
+        release = !RtlQueryEnvironmentVariable_U( NULL, &name, &value ) && buffer[0] == '1';
+    }
+    return release;
+}
+
+/* Emptied subheaps that are kept mapped, oldest first, for all heaps of the process. They are
+ * off their heap's subheap and free lists, so the heap never allocates from them again and
+ * allocations are placed exactly as when the subheap is released; only the address range
+ * stays reserved. The oldest ones are released once they reserve more than this: */
+#define HEAP_MAX_KEPT_SIZE (sizeof(void *) == 8 ? 0x10000000 : 0x4000000)
+
+static struct list kept_subheaps = LIST_INIT( kept_subheaps );
+static SIZE_T kept_subheaps_size;
+static RTL_SRWLOCK kept_subheaps_lock = RTL_SRWLOCK_INIT;
+
+static void release_subheap( SUBHEAP *subheap )
+{
+    void *addr = subheap_base( subheap );
+    SIZE_T size = 0;
+
+    NtFreeVirtualMemory( NtCurrentProcess(), &addr, &size, MEM_RELEASE );
+}
+
+static void keep_empty_subheap( SUBHEAP *subheap )
+{
+    SUBHEAP *oldest;
+
+    RtlAcquireSRWLockExclusive( &kept_subheaps_lock );
+    list_add_tail( &kept_subheaps, &subheap->entry );
+    kept_subheaps_size += subheap_size( subheap );
+    while (kept_subheaps_size > HEAP_MAX_KEPT_SIZE)
+    {
+        oldest = LIST_ENTRY( list_head( &kept_subheaps ), SUBHEAP, entry );
+        if (oldest == subheap) break;
+        list_remove( &oldest->entry );
+        kept_subheaps_size -= subheap_size( oldest );
+        release_subheap( oldest );
+    }
+    RtlReleaseSRWLockExclusive( &kept_subheaps_lock );
+}
+
+/* release the kept subheaps of a heap that is destroyed */
+static void release_kept_subheaps( struct heap *heap )
+{
+    SUBHEAP *subheap, *next;
+
+    RtlAcquireSRWLockExclusive( &kept_subheaps_lock );
+    LIST_FOR_EACH_ENTRY_SAFE( subheap, next, &kept_subheaps, SUBHEAP, entry )
+    {
+        if (subheap->user_value != heap) continue;
+        list_remove( &subheap->entry );
+        kept_subheaps_size -= subheap_size( subheap );
+        release_subheap( subheap );
+    }
+    RtlReleaseSRWLockExclusive( &kept_subheaps_lock );
+}
