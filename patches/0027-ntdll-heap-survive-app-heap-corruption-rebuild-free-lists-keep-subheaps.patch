+static struct block *find_free_block( struct heap *heap, ULONG flags, SIZE_T block_size )
+{
+    struct block *block;
+    SIZE_T total_size;
+    SUBHEAP *subheap;
+    BOOL fault;
+
+    /* Find a suitable free list, and in it find a block large enough */
+
+    block = search_free_lists( heap, block_size, &fault );
+    if (fault)
+    {
+        heap_rebuild_free_lists( heap );
+        block = search_free_lists( heap, block_size, &fault );
+    }
+    if (block)
+    {
+        if (!subheap_commit( heap, free_block_get_subheap( heap, block ), block, block_size )) return NULL;
+        list_remove( &((struct entry *)block)->entry );
+        return block;
+    }
 
     /* make sure we can fit the block and a free entry at the end */
     total_size = sizeof(SUBHEAP) + block_size + sizeof(struct entry);
