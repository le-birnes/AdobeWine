@@ -2081,6 +2175,60 @@ void heap_thread_detach(void)
 /***********************************************************************
  *           RtlAllocateHeap   (NTDLL.@)
  */
+/* Allocation / free with the heap lock held, made fault-safe: an app that writes to freed
+ * memory can break free-list links, and a fault here would kill the thread with the heap
+ * lock held, deadlocking the whole process (seen in Creative Cloud's helpers). On a fault
+ * the free lists are rebuilt from the block headers and the allocation is retried once; a
+ * free that faults leaves the block allocated (leaked) instead. */
+static NTSTATUS heap_allocate_block_guarded( struct heap *heap, ULONG flags, SIZE_T block_size, SIZE_T size, void **ret )
+{
+    NTSTATUS status = STATUS_NO_MEMORY;
+    BOOL fault = FALSE;
+    int attempt;
+
+    for (attempt = 0; attempt < 2; attempt++)
+    {
+        __TRY
+        {
+            status = heap_allocate_block( heap, flags, block_size, size, ret );
+            fault = FALSE;
+        }
+        __EXCEPT_PAGE_FAULT
+        {
+            fault = TRUE;
+        }
+        __ENDTRY
+        if (!fault) break;
+        heap_rebuild_free_lists( heap );
+        status = STATUS_NO_MEMORY;
+        *ret = NULL;
+    }
+    return status;
+}
+
+static NTSTATUS heap_free_block_guarded( struct heap *heap, ULONG flags, struct block *block )
+{
+    NTSTATUS status = STATUS_SUCCESS;
+    BOOL fault = FALSE;
+
+    __TRY
+    {
+        status = heap_free_block( heap, flags, block );
+    }
+    __EXCEPT_PAGE_FAULT
+    {
+        fault = TRUE;
+    }
+    __ENDTRY
+    if (fault)
+    {
+        WARN( "heap %p: fault while freeing block %p, leaking it\n", heap, block );
+        heap_rebuild_free_lists( heap );
+        status = STATUS_SUCCESS;
+    }
+    return status;
+}
