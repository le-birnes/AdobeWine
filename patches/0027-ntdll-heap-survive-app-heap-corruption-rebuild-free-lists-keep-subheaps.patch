+/* Search the free lists; *fault is set if a list link pointed to unmapped memory. */
+static struct block *search_free_lists( struct heap *heap, SIZE_T block_size, BOOL *fault )
+{
+    struct block *found = NULL;
+
+    *fault = FALSE;
+    __TRY
+    {
+        struct list *ptr = &find_free_list( heap, block_size, FALSE )->entry;
+
+        while (!found && (ptr = list_next( &heap->free_lists[0].entry, ptr )))
+        {
+            struct entry *entry = LIST_ENTRY( ptr, struct entry, entry );
+            struct block *block = &entry->block;
+
+            if (block_get_flags( block ) == BLOCK_FLAG_FREE_LINK) continue;
+            if (block_get_size( block ) < block_size) continue;
+            if (!free_block_get_subheap( heap, block ))
             {
                 /* Leave it linked: its neighbours may be just as broken. */
                 WARN( "heap %p: skipping corrupted free block %p (size %#Ix)\n", heap, block, block_get_size( block ) );
                 continue;
             }
-            if (!subheap_commit( heap, subheap, block, block_size )) return NULL;
-            list_remove( &entry->entry );
-            return block;
+            found = block;
         }
     }
+    __EXCEPT_PAGE_FAULT
+    {
+        *fault = TRUE;
+        found = NULL;
+    }
+    __ENDTRY
+
+    return found;
+}
