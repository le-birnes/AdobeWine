diff --git a/dlls/mfplat/buffer.c b/dlls/mfplat/buffer.c
--- a/dlls/mfplat/buffer.c
+++ b/dlls/mfplat/buffer.c
@@ -2928,3 +2928,127 @@
     *obj = &buffer->IMediaBuffer_iface;
     return S_OK;
 }
+
+struct wrapper_buffer
+{
+    IMFMediaBuffer IMFMediaBuffer_iface;
+    LONG refcount;
+    IMFMediaBuffer *parent;
+    DWORD offset;
+    DWORD max_length;
+    DWORD length;
+};
+
+static struct wrapper_buffer *impl_from_wrapper(IMFMediaBuffer *iface)
+{
+    return CONTAINING_RECORD(iface, struct wrapper_buffer, IMFMediaBuffer_iface);
+}
+
+static HRESULT WINAPI wrapper_buffer_QueryInterface(IMFMediaBuffer *iface, REFIID riid, void **obj)
+{
+    if (IsEqualIID(riid, &IID_IMFMediaBuffer) || IsEqualIID(riid, &IID_IUnknown))
+    {
+        *obj = iface;
+        IMFMediaBuffer_AddRef(iface);
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI wrapper_buffer_AddRef(IMFMediaBuffer *iface)
+{
+    return InterlockedIncrement(&impl_from_wrapper(iface)->refcount);
+}
+
+static ULONG WINAPI wrapper_buffer_Release(IMFMediaBuffer *iface)
+{
+    struct wrapper_buffer *buffer = impl_from_wrapper(iface);
+    ULONG refcount = InterlockedDecrement(&buffer->refcount);
+
+    if (!refcount)
+    {
+        IMFMediaBuffer_Release(buffer->parent);
+        free(buffer);
+    }
+    return refcount;
+}
+
+static HRESULT WINAPI wrapper_buffer_Lock(IMFMediaBuffer *iface, BYTE **data, DWORD *max_length, DWORD *current_length)
+{
+    struct wrapper_buffer *buffer = impl_from_wrapper(iface);
+    HRESULT hr;
+
+    if (!data) return E_INVALIDARG;
+    if (FAILED(hr = IMFMediaBuffer_Lock(buffer->parent, data, NULL, NULL))) return hr;
+    *data += buffer->offset;
+    if (max_length) *max_length = buffer->max_length;
+    if (current_length) *current_length = buffer->length;
+    return S_OK;
+}
+
+static HRESULT WINAPI wrapper_buffer_Unlock(IMFMediaBuffer *iface)
+{
+    return IMFMediaBuffer_Unlock(impl_from_wrapper(iface)->parent);
+}
+
+static HRESULT WINAPI wrapper_buffer_GetCurrentLength(IMFMediaBuffer *iface, DWORD *length)
+{
+    if (!length) return E_INVALIDARG;
+    *length = impl_from_wrapper(iface)->length;
+    return S_OK;
+}
+
+static HRESULT WINAPI wrapper_buffer_SetCurrentLength(IMFMediaBuffer *iface, DWORD length)
+{
+    struct wrapper_buffer *buffer = impl_from_wrapper(iface);
+
+    if (length > buffer->max_length) return E_INVALIDARG;
+    buffer->length = length;
+    return S_OK;
+}
+
+static HRESULT WINAPI wrapper_buffer_GetMaxLength(IMFMediaBuffer *iface, DWORD *length)
+{
+    if (!length) return E_INVALIDARG;
+    *length = impl_from_wrapper(iface)->max_length;
+    return S_OK;
+}
+
+static const IMFMediaBufferVtbl wrapper_buffer_vtbl =
+{
+    wrapper_buffer_QueryInterface,
+    wrapper_buffer_AddRef,
+    wrapper_buffer_Release,
+    wrapper_buffer_Lock,
+    wrapper_buffer_Unlock,
+    wrapper_buffer_GetCurrentLength,
+    wrapper_buffer_SetCurrentLength,
+    wrapper_buffer_GetMaxLength,
+};
+
+/***********************************************************************
+ *      MFCreateMediaBufferWrapper (mfplat.@)
+ */
+HRESULT WINAPI MFCreateMediaBufferWrapper(IMFMediaBuffer *parent, DWORD offset, DWORD length, IMFMediaBuffer **out)
+{
+    struct wrapper_buffer *buffer;
+    DWORD max_length;
+    HRESULT hr;
+
+    TRACE("%p, %lu, %lu, %p.\n", parent, offset, length, out);
+
+    if (!parent || !out) return E_POINTER;
+    if (FAILED(hr = IMFMediaBuffer_GetMaxLength(parent, &max_length))) return hr;
+    if (offset > max_length || length > max_length - offset) return E_INVALIDARG;
+    if (!(buffer = calloc(1, sizeof(*buffer)))) return E_OUTOFMEMORY;
+
+    buffer->IMFMediaBuffer_iface.lpVtbl = &wrapper_buffer_vtbl;
+    buffer->refcount = 1;
+    IMFMediaBuffer_AddRef(buffer->parent = parent);
+    buffer->offset = offset;
+    buffer->max_length = max_length - offset;
+    buffer->length = length;
+    *out = &buffer->IMFMediaBuffer_iface;
+    return S_OK;
+}
