win32u: Keep the NT handle of imported memory; no Win32 handle for memory that was not exported.

vkGetMemoryWin32HandleKHR() returned the memory's NT shared handle, which was only set for exported memory:
for imported memory it duplicated NULL, and DXVK, which opens the keyed mutex of an imported D3D11 texture
through that handle, failed to open the shared texture ("Failed to open shared NT handle"). Keep a
duplicate of the imported handle. For memory allocated without export, return
VK_ERROR_INVALID_EXTERNAL_HANDLE instead of a NULL handle with VK_SUCCESS, so callers such as
vkd3d-proton's CreateSharedHandle() fail instead of handing out NULL (After Effects then passed NULL to
CUDA).

--- a/dlls/win32u/vulkan.c
+++ b/dlls/win32u/vulkan.c
@@ -947,7 +947,12 @@
             HANDLE shared = import_win32->handle;
             if (import_win32->name && !(shared = open_shared_resource_from_name( import_win32->name ))) break;
             memory->local = d3dkmt_open_resource( 0, shared, &memory->mutex, &memory->sync );
-            if (shared && shared != import_win32->handle) NtClose( shared );
+            /* keep the shared handle: vkGetMemoryWin32HandleKHR returns it for imported memory too
+             * (DXVK opens the keyed mutex of an imported D3D11 texture through it) */
+            if (shared == import_win32->handle)
+                NtDuplicateObject( NtCurrentProcess(), shared, NtCurrentProcess(), &memory->shared, 0, 0,
+                                   DUPLICATE_SAME_ATTRIBUTES | DUPLICATE_SAME_ACCESS );
+            else memory->shared = shared;
             break;
         }
         default:
@@ -1081,6 +1086,8 @@
     {
     case VK_EXTERNAL_MEMORY_HANDLE_TYPE_OPAQUE_WIN32_KMT_BIT:
     case VK_EXTERNAL_MEMORY_HANDLE_TYPE_D3D11_TEXTURE_KMT_BIT:
+        /* memory that was not allocated for export has no handle to give out */
+        if (!memory->global) return VK_ERROR_INVALID_EXTERNAL_HANDLE;
         TRACE( "Returning global D3DKMT handle %#x\n", memory->global );
         *handle = UlongToPtr( memory->global );
         return VK_SUCCESS;
@@ -1089,6 +1096,7 @@
     case VK_EXTERNAL_MEMORY_HANDLE_TYPE_D3D11_TEXTURE_BIT:
     case VK_EXTERNAL_MEMORY_HANDLE_TYPE_D3D12_HEAP_BIT:
     case VK_EXTERNAL_MEMORY_HANDLE_TYPE_D3D12_RESOURCE_BIT:
+        if (!memory->shared) return VK_ERROR_INVALID_EXTERNAL_HANDLE;
         NtDuplicateObject( NtCurrentProcess(), memory->shared, NtCurrentProcess(), handle, 0, 0, DUPLICATE_SAME_ATTRIBUTES | DUPLICATE_SAME_ACCESS );
         TRACE( "Returning NT shared handle %p -> %p\n", memory->shared, *handle );
         return VK_SUCCESS;
