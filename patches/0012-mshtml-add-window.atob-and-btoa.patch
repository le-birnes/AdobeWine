+static int base64_char_value(WCHAR c)
+{
+    if(c >= 'A' && c <= 'Z') return c - 'A';
+    if(c >= 'a' && c <= 'z') return c - 'a' + 26;
+    if(c >= '0' && c <= '9') return c - '0' + 52;
+    if(c == '+') return 62;
+    if(c == '/') return 63;
+    return -1;
+}
+
+static HRESULT WINAPI window_private_atob(IWineHTMLWindowPrivate *iface, BSTR encoded, BSTR *decoded)
+{
+    unsigned len = SysStringLen(encoded), i, n = 0, out_len = 0, bits = 0, acc = 0;
+    WCHAR *buf, *out;
+
+    TRACE("iface %p, encoded %s, decoded %p\n", iface, debugstr_w(encoded), decoded);
+
+    if(!(buf = malloc((len + 1) * sizeof(WCHAR))))
+        return E_OUTOFMEMORY;
+
+    /* strip ASCII whitespace */
+    for(i = 0; i < len; i++) {
+        WCHAR c = encoded[i];
+        if(c == ' ' || c == '\t' || c == '\n' || c == '\f' || c == '\r') continue;
+        buf[n++] = c;
+    }
+
+    /* strip padding */
+    if(!(n % 4)) {
+        if(n && buf[n - 1] == '=') n--;
+        if(n && buf[n - 1] == '=') n--;
+    }
+    if(n % 4 == 1) {
+        free(buf);
+        return E_INVALIDARG;
+    }
+
+    if(!(out = malloc((n * 3 / 4 + 1) * sizeof(WCHAR)))) {
+        free(buf);
+        return E_OUTOFMEMORY;
+    }
+
+    for(i = 0; i < n; i++) {
+        int v = base64_char_value(buf[i]);
+        if(v < 0) {
+            free(buf);
+            free(out);
+            return E_INVALIDARG;
+        }
+        acc = (acc << 6) | v;
+        bits += 6;
+        if(bits >= 8) {
+            bits -= 8;
+            out[out_len++] = (acc >> bits) & 0xff;
+        }
+    }
+
+    /* The result is a binary string and may contain embedded nulls. */
+    *decoded = SysAllocStringLen(out, out_len);
+    free(buf);
+    free(out);
+    return *decoded ? S_OK : E_OUTOFMEMORY;
+}
+
+static HRESULT WINAPI window_private_btoa(IWineHTMLWindowPrivate *iface, BSTR str, BSTR *encoded)
+{
+    static const char table[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+    unsigned len = SysStringLen(str), i, o = 0;
+    WCHAR *out;
+
+    TRACE("iface %p, str %s, encoded %p\n", iface, debugstr_w(str), encoded);
+
+    for(i = 0; i < len; i++)
+        if(str[i] > 0xff) return E_INVALIDARG;
+
+    if(!(out = malloc(((len + 2) / 3 * 4 + 1) * sizeof(WCHAR))))
+        return E_OUTOFMEMORY;
+
+    for(i = 0; i + 2 < len; i += 3) {
+        unsigned v = (str[i] << 16) | (str[i + 1] << 8) | str[i + 2];
+        out[o++] = table[(v >> 18) & 0x3f];
+        out[o++] = table[(v >> 12) & 0x3f];
+        out[o++] = table[(v >> 6) & 0x3f];
+        out[o++] = table[v & 0x3f];
+    }
+    if(len - i == 1) {
+        unsigned v = str[i] << 16;
+        out[o++] = table[(v >> 18) & 0x3f];
+        out[o++] = table[(v >> 12) & 0x3f];
+        out[o++] = '=';
+        out[o++] = '=';
+    }else if(len - i == 2) {
+        unsigned v = (str[i] << 16) | (str[i + 1] << 8);
+        out[o++] = table[(v >> 18) & 0x3f];
+        out[o++] = table[(v >> 12) & 0x3f];
+        out[o++] = table[(v >> 6) & 0x3f];
+        out[o++] = '=';
+    }
+
+    *encoded = SysAllocStringLen(out, o);
+    free(out);
+    return *encoded ? S_OK : E_OUTOFMEMORY;
+}
