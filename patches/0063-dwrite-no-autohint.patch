From: nvb-uy <105564560+nvb-uy@users.noreply.github.com>
Subject: [PATCH] dwrite: Do not auto-hint glyphs, and do not hint glyph run outlines.

Fonts that ship without hinting instructions, like Selawik installed as Segoe UI, went
through FreeType's auto-hinter, which moves stems and changes advance widths. Windows never
auto-hints. Load glyphs with FT_LOAD_NO_AUTOHINT so hinted fonts keep their own instructions
and unhinted ones are rasterized as designed. GetGlyphRunOutline returns unhinted outlines on
Windows, so load those with FT_LOAD_NO_HINTING.
---
diff --git a/dlls/dwrite/freetype.c b/dlls/dwrite/freetype.c
--- a/dlls/dwrite/freetype.c
+++ b/dlls/dwrite/freetype.c
@@ -448,7 +448,7 @@ static NTSTATUS get_glyph_outline(void *args)
     if (!(size = freetype_set_face_size(face, params->emsize)))
         return STATUS_UNSUCCESSFUL;
 
-    if (!pFT_Load_Glyph(face, params->glyph, FT_LOAD_NO_BITMAP))
+    if (!pFT_Load_Glyph(face, params->glyph, FT_LOAD_NO_BITMAP | FT_LOAD_NO_HINTING))
     {
         FT_Outline *ft_outline = &face->glyph->outline;
         FT_Matrix m;
@@ -544,7 +544,7 @@ static NTSTATUS get_glyph_bbox(void *args)
 
     needs_transform = FT_IS_SCALABLE(face) && get_glyph_transform(params->simulations, &params->m, &m);
 
-    if (pFT_Load_Glyph(face, params->glyph, needs_transform ? FT_LOAD_NO_BITMAP : 0))
+    if (pFT_Load_Glyph(face, params->glyph, (needs_transform ? FT_LOAD_NO_BITMAP : 0) | FT_LOAD_NO_AUTOHINT))
     {
         WARN("Failed to load glyph %u.\n", params->glyph);
         pFT_Done_Size(size);
@@ -685,7 +685,7 @@ static NTSTATUS get_glyph_bitmap(void *args)
 
     needs_transform = FT_IS_SCALABLE(face) && get_glyph_transform(params->simulations, &params->m, &m);
 
-    if (!pFT_Load_Glyph(face, params->glyph, needs_transform ? FT_LOAD_NO_BITMAP : 0))
+    if (!pFT_Load_Glyph(face, params->glyph, (needs_transform ? FT_LOAD_NO_BITMAP : 0) | FT_LOAD_NO_AUTOHINT))
     {
         pFT_Get_Glyph(face->glyph, &glyph);
 
@@ -723,7 +723,7 @@ static NTSTATUS get_glyph_advance(void *args)
     if (!(size = freetype_set_face_size(face, params->emsize)))
         return STATUS_UNSUCCESSFUL;
 
-    if (!pFT_Load_Glyph(face, params->glyph, params->mode == DWRITE_MEASURING_MODE_NATURAL ? FT_LOAD_NO_HINTING : 0))
+    if (!pFT_Load_Glyph(face, params->glyph, params->mode == DWRITE_MEASURING_MODE_NATURAL ? FT_LOAD_NO_HINTING : FT_LOAD_NO_AUTOHINT))
     {
         *params->advance = face->glyph->advance.x >> 6;
         *params->has_contours = freetype_glyph_has_contours(face);
