+/* Re-copy offscreen client surfaces (Vulkan / OpenGL content presented into a child or
+ * layered window) to their toplevel. Their content is only copied at present time, so a
+ * later flush of the GDI window surface would otherwise overwrite it for good. */
+void present_offscreen_client_surfaces( HWND toplevel )
+{
+    static LONG presenting;
+    struct client_surface *surface, *surfaces[32];
+    unsigned int i, count = 0;
+
+    static int disabled = -1;
+
+    if (disabled < 0) disabled = getenv( "WINE_NO_OFFSCREEN_REPRESENT" ) != NULL;
+    if (disabled) return;
+    if (InterlockedCompareExchange( &presenting, 1, 0 )) return;
+
+    pthread_mutex_lock( &surfaces_lock );
+    LIST_FOR_EACH_ENTRY( surface, &client_surfaces, struct client_surface, entry )
+    {
+        if (!surface->hwnd || !surface->offscreen || surface->toplevel != toplevel) continue;
+        if (count == ARRAY_SIZE(surfaces)) break;
+        InterlockedIncrement( &surface->ref );
+        surfaces[count++] = surface;
+    }
+    pthread_mutex_unlock( &surfaces_lock );
+
+    for (i = 0; i < count; i++)
+    {
+        client_surface_present( surfaces[i] );
+        client_surface_release( surfaces[i] );
+    }
+
+    InterlockedExchange( &presenting, 0 );
+}
