+sync_test("Object.entries", function() {
+    var o, r, getter_calls = 0;
+
+    if(!Object.entries) {
+        win_skip("Object.entries not supported");
+        return;
+    }
+
+    ok(Object.entries.length === 1, "Object.entries.length = " + Object.entries.length);
+    ok(Object.values.length === 1, "Object.values.length = " + Object.values.length);
+    ok(!Object.prototype.propertyIsEnumerable.call(Object, "entries"), "Object.entries is enumerable");
+
+    o = { a: 1, b: "x" };
+    o.c = null;
+    Object.defineProperty(o, "hidden", { value: 3, enumerable: false });
+    Object.defineProperty(o, "getter", { get: function() { getter_calls++; return 42; }, enumerable: true });
+
+    r = Object.entries(o);
+    ok(Array.isArray(r), "entries did not return an array");
+    ok(r.length === 4, "entries length = " + r.length);
+    ok(Array.isArray(r[0]) && r[0].length === 2, "entries[0] = " + r[0]);
+    ok(r[0][0] === "a" && r[0][1] === 1, "entries[0] = " + r[0]);
+    ok(r[1][0] === "b" && r[1][1] === "x", "entries[1] = " + r[1]);
+    ok(r[2][0] === "c" && r[2][1] === null, "entries[2] = " + r[2]);
+    ok(r[3][0] === "getter" && r[3][1] === 42, "entries[3] = " + r[3]);
+    ok(getter_calls === 1, "getter_calls = " + getter_calls);
+
+    r = Object.values(o);
+    ok(r.join() === "1,x,,42", "values = " + r.join());
+    ok(getter_calls === 2, "getter_calls = " + getter_calls);
+
+    r = Object.entries(Object.create({ inherited: 1 }));
+    ok(r.length === 0, "entries of object with inherited prop length = " + r.length);
+    r = Object.values([ "p", "q" ]);
+    ok(r.join() === "p,q", "values of array = " + r.join());
+    r = Object.entries(function() {});
+    ok(r.length === 0, "entries of function length = " + r.length);
+
+    /* a property deleted by an earlier getter is skipped */
+    o = {};
+    Object.defineProperty(o, "first", { get: function() { delete o.second; return 1; }, enumerable: true, configurable: true });
+    o.second = 2;
+    r = Object.values(o);
+    ok(r.join() === "1", "values with deleting getter = " + r.join());
+
+    r = Object.entries(42);
+    ok(r.length === 0, "entries(42) length = " + r.length);
+
+    try {
+        Object.entries(undefined);
+        ok(false, "expected exception calling entries(undefined)");
+    }catch(ex) {
+        var n = ex.number >>> 0;
+        ok(n === JS_E_OBJECT_EXPECTED, "entries(undefined) threw " + n);
+    }
+    try {
+        Object.values(null);
+        ok(false, "expected exception calling values(null)");
+    }catch(ex) {
+        var n = ex.number >>> 0;
+        ok(n === JS_E_OBJECT_EXPECTED, "values(null) threw " + n);
+    }
+});
