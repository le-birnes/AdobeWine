index 9812b27..dcdebe8 100644
--- a/dlls/jscript/object.c
+++ b/dlls/jscript/object.c
@@ -927,6 +927,237 @@ static HRESULT Object_getOwnPropertyNames(script_ctx_t *ctx, jsval_t vthis, WORD
     return object_keys(ctx, arg, JSDISP_ENUM_OWN, r);
