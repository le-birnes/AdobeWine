+static HRESULT get_own_enumerable_keys(jsdisp_t *obj, jsstr_t ***ret, unsigned *ret_cnt)
+{
+    DISPID id = DISPID_STARTENUM;
+    unsigned cnt = 0, size = 0;
+    jsstr_t **keys = NULL, **new_keys;
+    HRESULT hres;
+
+    for(;;) {
+        hres = jsdisp_next_prop(obj, id, JSDISP_ENUM_OWN_ENUMERABLE, &id);
+        if(hres != S_OK)
+            break;
+
+        if(cnt == size) {
+            size = size ? size * 2 : 16;
+            if(!(new_keys = realloc(keys, size * sizeof(*keys)))) {
+                hres = E_OUTOFMEMORY;
+                break;
+            }
+            keys = new_keys;
+        }
+
+        hres = jsdisp_get_prop_name(obj, id, &keys[cnt]);
+        if(FAILED(hres))
+            break;
+        cnt++;
+    }
+
+    if(FAILED(hres)) {
+        while(cnt)
+            jsstr_release(keys[--cnt]);
+        free(keys);
+        return hres;
+    }
+
+    *ret = keys;
+    *ret_cnt = cnt;
+    return S_OK;
+}
+
+static void release_keys(jsstr_t **keys, unsigned cnt)
+{
+    while(cnt)
+        jsstr_release(keys[--cnt]);
+    free(keys);
+}
+
+/* Gets the value of an own property if it still exists and is enumerable,
+ * returns S_FALSE otherwise. */
+static HRESULT get_own_enumerable_value(jsdisp_t *obj, jsstr_t *key, jsval_t *val)
+{
+    property_desc_t desc;
+    const WCHAR *name;
+    HRESULT hres;
+
+    if(!(name = jsstr_flatten(key)))
+        return E_OUTOFMEMORY;
+
+    hres = jsdisp_get_own_property(obj, name, TRUE, &desc);
+    if(hres == DISP_E_UNKNOWNNAME)
+        return S_FALSE;
+    if(FAILED(hres))
+        return hres;
+    if(!(desc.flags & PROPF_ENUMERABLE))
+        return S_FALSE;
+
+    return jsdisp_propget_name(obj, name, val);
+}
+
+static HRESULT object_entries(script_ctx_t *ctx, jsval_t arg, BOOL values_only, jsval_t *r)
+{
+    jsdisp_t *obj, *array = NULL, *entry;
+    unsigned i, cnt, len = 0;
+    jsstr_t **keys;
+    IDispatch *disp;
+    jsval_t val;
+    HRESULT hres;
+
+    hres = to_object(ctx, arg, &disp);
+    if(FAILED(hres))
+        return hres;
+
+    if(!(obj = to_jsdisp(disp))) {
+        FIXME("Non-JS object\n");
+        IDispatch_Release(disp);
+        return E_NOTIMPL;
+    }
+
+    hres = get_own_enumerable_keys(obj, &keys, &cnt);
+    if(FAILED(hres)) {
+        jsdisp_release(obj);
+        return hres;
+    }
+
+    hres = create_array(ctx, 0, &array);
+    for(i = 0; SUCCEEDED(hres) && i < cnt; i++) {
+        hres = get_own_enumerable_value(obj, keys[i], &val);
+        if(hres != S_OK)
+            continue;
+
+        if(!values_only) {
+            hres = create_array(ctx, 0, &entry);
+            if(SUCCEEDED(hres)) {
+                hres = jsdisp_propput_idx(entry, 0, jsval_string(keys[i]));
+                if(SUCCEEDED(hres))
+                    hres = jsdisp_propput_idx(entry, 1, val);
+                jsval_release(val);
+                if(FAILED(hres)) {
+                    jsdisp_release(entry);
+                    break;
+                }
+                val = jsval_obj(entry);
+            }else {
+                jsval_release(val);
+                break;
+            }
+        }
+
+        hres = jsdisp_propput_idx(array, len++, val);
+        jsval_release(val);
+    }
+    if(hres == S_FALSE)
+        hres = S_OK;
+
+    release_keys(keys, cnt);
+    jsdisp_release(obj);
+    if(FAILED(hres)) {
+        if(array)
+            jsdisp_release(array);
+        return hres;
+    }
+
+    if(r)
+        *r = jsval_obj(array);
+    else
+        jsdisp_release(array);
+    return S_OK;
+}
+
+static HRESULT Object_entries(script_ctx_t *ctx, jsval_t vthis, WORD flags,
+                              unsigned argc, jsval_t *argv, jsval_t *r)
+{
+    jsval_t arg = argc ? argv[0] : jsval_undefined();
+
+    TRACE("(%s)\n", debugstr_jsval(arg));
+
+    return object_entries(ctx, arg, FALSE, r);
+}
+
+static HRESULT Object_values(script_ctx_t *ctx, jsval_t vthis, WORD flags,
+                             unsigned argc, jsval_t *argv, jsval_t *r)
+{
+    jsval_t arg = argc ? argv[0] : jsval_undefined();
+
+    TRACE("(%s)\n", debugstr_jsval(arg));
+
+    return object_entries(ctx, arg, TRUE, r);
+}
+
+static HRESULT Object_assign(script_ctx_t *ctx, jsval_t vthis, WORD flags,
+                             unsigned argc, jsval_t *argv, jsval_t *r)
+{
+    IDispatch *target, *source_disp;
+    jsdisp_t *source, *target_obj;
+    unsigned i, j, cnt;
+    jsstr_t **keys;
+    jsval_t val;
+    HRESULT hres;
+
+    TRACE("(%s)\n", debugstr_jsval(argc ? argv[0] : jsval_undefined()));
+
+    hres = to_object(ctx, argc ? argv[0] : jsval_undefined(), &target);
+    if(FAILED(hres))
+        return hres;
+    target_obj = to_jsdisp(target);
+
+    for(i = 1; i < argc; i++) {
+        if(is_undefined(argv[i]) || is_null(argv[i]))
+            continue;
+
+        hres = to_object(ctx, argv[i], &source_disp);
+        if(FAILED(hres))
+            break;
+
+        if(!(source = to_jsdisp(source_disp))) {
+            FIXME("Non-JS source object\n");
+            IDispatch_Release(source_disp);
+            hres = E_NOTIMPL;
+            break;
+        }
+
+        hres = get_own_enumerable_keys(source, &keys, &cnt);
+        if(FAILED(hres)) {
+            jsdisp_release(source);
+            break;
+        }
+
+        for(j = 0; j < cnt; j++) {
+            hres = get_own_enumerable_value(source, keys[j], &val);
+            if(FAILED(hres))
+                break;
+            if(hres == S_FALSE)
+                continue;
+
+            if(target_obj)
+                hres = jsdisp_propput(target_obj, jsstr_flatten(keys[j]),
+                                      PROPF_ENUMERABLE | PROPF_CONFIGURABLE | PROPF_WRITABLE, TRUE, val);
+            else
+                hres = disp_propput_name(ctx, target, jsstr_flatten(keys[j]), val);
+            jsval_release(val);
+            if(FAILED(hres))
+                break;
+        }
+
+        release_keys(keys, cnt);
+        jsdisp_release(source);
+        if(FAILED(hres))
+            break;
+    }
+
+    if(FAILED(hres)) {
+        IDispatch_Release(target);
+        return hres;
+    }
+
+    if(r)
+        *r = jsval_disp(target);
+    else
+        IDispatch_Release(target);
+    return S_OK;
+}
