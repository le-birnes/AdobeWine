+sync_test("Object.assign", function() {
+    var target, r, log = "";
+
+    if(!Object.assign) {
+        win_skip("Object.assign not supported");
+        return;
+    }
+
+    ok(Object.assign.length === 2, "Object.assign.length = " + Object.assign.length);
+
+    target = { a: 1, b: 1 };
+    r = Object.assign(target, { b: 2, c: 2 }, null, undefined, { c: 3, d: 3 });
+    ok(r === target, "assign did not return target");
+    ok(target.a === 1 && target.b === 2 && target.c === 3 && target.d === 3,
+       "target = " + target.a + "," + target.b + "," + target.c + "," + target.d);
+
+    /* only own enumerable properties are copied, through the getter */
+    var src = Object.create({ inherited: 1 });
+    src.own = 1;
+    Object.defineProperty(src, "hidden", { value: 1, enumerable: false });
+    Object.defineProperty(src, "getter", { get: function() { log += "get;"; return 5; }, enumerable: true });
+    target = {};
+    Object.defineProperty(target, "getter", { set: function(v) { log += "set " + v + ";"; }, enumerable: true });
+    Object.assign(target, src);
+    ok(target.own === 1, "target.own = " + target.own);
+    ok(!("inherited" in target), "inherited prop copied");
+    ok(!("hidden" in target), "non-enumerable prop copied");
+    ok(log === "get;set 5;", "log = " + log);
+
+    r = Object.assign({}, [ "x", "y" ]);
+    ok(r[0] === "x" && r[1] === "y", "assign from array = " + r[0] + "," + r[1]);
+
+    r = Object.assign(1);
+    ok(typeof(r) === "object" && r.valueOf() === 1, "assign(1) = " + r);
+    r = Object.assign("s");
+    ok(typeof(r) === "object" && r.valueOf() === "s", "assign(\"s\") = " + r);
+
+    try {
+        Object.assign(null, {});
+        ok(false, "expected exception calling assign(null)");
+    }catch(ex) {
+        var n = ex.number >>> 0;
+        ok(n === JS_E_OBJECT_EXPECTED, "assign(null) threw " + n);
+    }
+    try {
+        Object.assign();
+        ok(false, "expected exception calling assign()");
+    }catch(ex) {
+        var n = ex.number >>> 0;
+        ok(n === JS_E_OBJECT_EXPECTED, "assign() threw " + n);
+    }
+
+    target = Object.freeze({});
+    try {
+        Object.assign(target, { a: 1 });
+        ok(false, "expected exception assigning to frozen object");
+    }catch(ex) {
+        ok(ex.name === "TypeError", "assign to frozen object threw " + ex.name);
+    }
+});
