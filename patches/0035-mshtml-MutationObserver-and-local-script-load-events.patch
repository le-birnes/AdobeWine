+static HRESULT create_js_array(HTMLInnerWindow *window, IDispatchEx **ret)
+{
+    IDispatchEx *global = (IDispatchEx*)&window->event_target.dispex.IWineJSDispatchHost_iface;
+    DISPPARAMS dp = { 0 };
+    BSTR name;
+    VARIANT v;
+    DISPID id;
+    HRESULT hres;
+
+    if(!(name = SysAllocString(L"Array")))
+        return E_OUTOFMEMORY;
+    hres = IDispatchEx_GetDispID(global, name, fdexNameCaseSensitive, &id);
+    SysFreeString(name);
+    if(FAILED(hres))
+        return hres;
+
+    V_VT(&v) = VT_EMPTY;
+    hres = IDispatchEx_InvokeEx(global, id, LOCALE_NEUTRAL, DISPATCH_CONSTRUCT, &dp, &v, NULL, NULL);
+    if(FAILED(hres))
+        return hres;
+    if(V_VT(&v) != VT_DISPATCH || !V_DISPATCH(&v)) {
+        VariantClear(&v);
+        return E_FAIL;
+    }
+    hres = IDispatch_QueryInterface(V_DISPATCH(&v), &IID_IDispatchEx, (void**)ret);
+    VariantClear(&v);
+    return hres;
+}
+
+static HRESULT js_array_push(IDispatchEx *array, VARIANT *v)
+{
+    DISPPARAMS dp = { v, NULL, 1, 0 };
+    BSTR name;
+    DISPID id;
+    HRESULT hres;
+
+    if(!(name = SysAllocString(L"push")))
+        return E_OUTOFMEMORY;
+    hres = IDispatchEx_GetDispID(array, name, fdexNameCaseSensitive, &id);
+    SysFreeString(name);
+    if(SUCCEEDED(hres))
+        hres = IDispatchEx_InvokeEx(array, id, LOCALE_NEUTRAL, DISPATCH_METHOD, &dp, NULL, NULL, NULL);
+    return hres;
+}
+
+static void node_to_variant(nsIDOMNode *nsnode, VARIANT *v)
+{
+    HTMLDOMNode *node;
+
+    V_VT(v) = VT_NULL;
+    if(nsnode && SUCCEEDED(get_node(nsnode, TRUE, &node))) {
+        V_VT(v) = VT_DISPATCH;
+        V_DISPATCH(v) = (IDispatch*)&node->IHTMLDOMNode_iface;
+    }
+}
+
+static HRESULT define_record_prop(IWineJSDispatch *obj, const WCHAR *name, VARIANT *v)
+{
+    HRESULT hres = IWineJSDispatch_DefineProperty(obj, name, PROPF_WRITABLE | PROPF_ENUMERABLE | PROPF_CONFIGURABLE, v);
+    VariantClear(v);
+    return hres;
+}
+
+static HRESULT create_node_array(HTMLInnerWindow *window, nsIDOMNode **nodes, UINT cnt, VARIANT *ret)
+{
+    IDispatchEx *array;
+    VARIANT v;
+    HRESULT hres;
+    UINT i;
+
+    if(FAILED(hres = create_js_array(window, &array)))
+        return hres;
+    for(i = 0; i < cnt && SUCCEEDED(hres); i++) {
+        node_to_variant(nodes[i], &v);
+        hres = js_array_push(array, &v);
+        VariantClear(&v);
+    }
+    V_VT(ret) = VT_DISPATCH;
+    V_DISPATCH(ret) = (IDispatch*)array;
+    return hres;
+}
+
+static HRESULT create_record_object(HTMLInnerWindow *window, struct mutation_record *record, VARIANT *ret)
+{
+    static const WCHAR *type_names[] = { NULL, L"childList", L"attributes", NULL, L"characterData" };
+    IWineJSDispatch *obj;
+    VARIANT v;
+    HRESULT hres;
+
+    hres = IWineJScript_CreateObject(window->jscript, &obj);
+    if(FAILED(hres))
+        return hres;
+
+    V_VT(&v) = VT_BSTR;
+    V_BSTR(&v) = SysAllocString(type_names[record->type]);
+    hres = define_record_prop(obj, L"type", &v);
+    if(SUCCEEDED(hres)) {
+        node_to_variant(record->target, &v);
+        hres = define_record_prop(obj, L"target", &v);
+    }
+    if(SUCCEEDED(hres)) {
+        if(record->attr_name) {
+            V_VT(&v) = VT_BSTR;
+            V_BSTR(&v) = SysAllocString(record->attr_name);
+        }else {
+            V_VT(&v) = VT_NULL;
+        }
+        hres = define_record_prop(obj, L"attributeName", &v);
+    }
+    if(SUCCEEDED(hres)) {
+        V_VT(&v) = VT_NULL;
+        hres = define_record_prop(obj, L"attributeNamespace", &v);
+    }
+    if(SUCCEEDED(hres)) {
+        V_VT(&v) = VT_NULL;
+        hres = define_record_prop(obj, L"oldValue", &v);
+    }
+    if(SUCCEEDED(hres) && SUCCEEDED(hres = create_node_array(window, record->added, record->added_cnt, &v)))
+        hres = define_record_prop(obj, L"addedNodes", &v);
+    if(SUCCEEDED(hres) && SUCCEEDED(hres = create_node_array(window, &record->removed, record->removed ? 1 : 0, &v)))
+        hres = define_record_prop(obj, L"removedNodes", &v);
+    if(SUCCEEDED(hres)) {
+        V_VT(&v) = VT_NULL;
+        hres = define_record_prop(obj, L"previousSibling", &v);
+    }
+    if(SUCCEEDED(hres)) {
+        V_VT(&v) = VT_NULL;
+        hres = define_record_prop(obj, L"nextSibling", &v);
+    }
+    if(FAILED(hres)) {
+        IWineJSDispatch_Release(obj);
+        return hres;
+    }
+
+    V_VT(ret) = VT_DISPATCH;
+    V_DISPATCH(ret) = (IDispatch*)obj;
+    return S_OK;
+}
+
+/* Turns the pending records into a JS array (empty records are taken by the caller). */
+static HRESULT take_records(struct mutation_observer *This, VARIANT *ret)
+{
+    struct mutation_record *record, *next;
+    IDispatchEx *array;
+    VARIANT v;
+    HRESULT hres;
+
+    V_VT(ret) = VT_NULL;
+    if(!This->window || !This->window->jscript) {
+        clear_mutation_records(This);
+        return S_OK;
+    }
+
+    if(FAILED(hres = create_js_array(This->window, &array))) {
+        clear_mutation_records(This);
+        return hres;
+    }
+
+    LIST_FOR_EACH_ENTRY_SAFE(record, next, &This->records, struct mutation_record, entry) {
+        list_remove(&record->entry);
+        if(SUCCEEDED(create_record_object(This->window, record, &v))) {
+            js_array_push(array, &v);
+            VariantClear(&v);
+        }
+        free_mutation_record(record);
+    }
+
+    V_VT(ret) = VT_DISPATCH;
+    V_DISPATCH(ret) = (IDispatch*)array;
+    return S_OK;
+}
+
+struct mutation_task {
+    task_t header;
+    struct mutation_observer *observer;
+};
+
+static void mutation_task_proc(task_t *_task)
+{
+    struct mutation_task *task = (struct mutation_task*)_task;
+    struct mutation_observer *This = task->observer;
+    VARIANT args[2], res;
+    DISPPARAMS dp = { args, NULL, 2, 0 };
+
+    This->task_pending = FALSE;
+    if(list_empty(&This->records) || !This->callback)
+        return;
+
+    TRACE("(%p) delivering records\n", This);
+
+    take_records(This, &args[1]);
+    V_VT(&args[0]) = VT_DISPATCH;
+    V_DISPATCH(&args[0]) = (IDispatch*)&This->IWineMSHTMLMutationObserver_iface;
+    V_VT(&res) = VT_EMPTY;
+    call_disp_func(This->callback, &dp, &res);
+    VariantClear(&res);
+    VariantClear(&args[1]);
+}
+
+static void mutation_task_destr(task_t *_task)
+{
+    struct mutation_task *task = (struct mutation_task*)_task;
+    IWineMSHTMLMutationObserver_Release(&task->observer->IWineMSHTMLMutationObserver_iface);
+}
+
+static void queue_mutation_record(struct mutation_observer *This, DWORD type, nsIDOMNode *target,
+                                  const WCHAR *attr_name, nsIDOMNode *added, BOOL added_siblings,
+                                  nsIDOMNode *removed)
+{
+    struct mutation_record *record;
+    struct mutation_task *task;
+    nsIDOMNode *iter, *next;
+
+    if(!(record = calloc(1, sizeof(*record))))
+        return;
+    record->type = type;
+    nsIDOMNode_AddRef(record->target = target);
+    if(attr_name)
+        record->attr_name = SysAllocString(attr_name);
+    for(iter = added; iter; iter = next) {
+        nsIDOMNode **tmp = realloc(record->added, (record->added_cnt + 1) * sizeof(*tmp));
+        if(!tmp)
+            break;
+        record->added = tmp;
+        nsIDOMNode_AddRef(record->added[record->added_cnt++] = iter);
+        next = NULL;
+        if(added_siblings)
+            nsIDOMNode_GetNextSibling(iter, &next);
+        if(iter != added)
+            nsIDOMNode_Release(iter);
+    }
+    if(removed)
+        nsIDOMNode_AddRef(record->removed = removed);
+    list_add_tail(&This->records, &record->entry);
+
+    if(This->task_pending || !This->window)
+        return;
+    if(!(task = malloc(sizeof(*task))))
+        return;
+    IWineMSHTMLMutationObserver_AddRef(&This->IWineMSHTMLMutationObserver_iface);
+    task->observer = This;
+    if(SUCCEEDED(push_task(&task->header, mutation_task_proc, mutation_task_destr, This->window->task_magic)))
+        This->task_pending = TRUE;
+}
+
+static BOOL node_in_scope(nsIDOMNode *node, nsIDOMNode *target, BOOL subtree)
+{
+    nsIDOMNode *iter, *parent;
+    BOOL ret = FALSE;
+
+    if(node == target)
+        return TRUE;
+    if(!subtree)
+        return FALSE;
+
+    nsIDOMNode_AddRef(iter = node);
+    while(NS_SUCCEEDED(nsIDOMNode_GetParentNode(iter, &parent)) && parent) {
+        nsIDOMNode_Release(iter);
+        iter = parent;
+        if(iter == target) {
+            ret = TRUE;
+            break;
+        }
+    }
+    nsIDOMNode_Release(iter);
+    return ret;
+}
+
+static void notify_mutation(DWORD type, nsIDOMNode *target, const WCHAR *attr_name,
+                            nsIDOMNode *added, BOOL added_siblings, nsIDOMNode *removed)
+{
+    struct mutation_observer *observer, *next;
+    UINT i;
+
+    LIST_FOR_EACH_ENTRY_SAFE(observer, next, &active_observers, struct mutation_observer, entry) {
+        for(i = 0; i < observer->observation_cnt; i++) {
+            if(!(observer->observations[i].flags & type))
+                continue;
+            if(node_in_scope(target, observer->observations[i].target,
+                             !!(observer->observations[i].flags & OBSERVE_SUBTREE))) {
+                queue_mutation_record(observer, type, target, attr_name, added, added_siblings, removed);
+                break;
+            }
+        }
+    }
+}
+
+static nsIDOMNode *dom_node_from_content(void *content)
+{
+    nsIDOMNode *node = NULL;
+
+    if(content && NS_FAILED(nsISupports_QueryInterface((nsISupports*)content, &IID_nsIDOMNode, (void**)&node)))
+        node = NULL;
+    return node;
+}
+
+/* Gecko reports changes only for nodes that are part of a document; script changes to
+ * detached character data come through here. */
+void mutation_observer_char_data_set(nsIDOMNode *nsnode)
+{
+    nsIDOMNode *iter, *parent;
+    UINT16 type = 0;
+
+    if(list_empty(&active_observers) || !nsnode)
+        return;
+
+    nsIDOMNode_AddRef(iter = nsnode);
+    while(NS_SUCCEEDED(nsIDOMNode_GetParentNode(iter, &parent)) && parent) {
+        nsIDOMNode_Release(iter);
+        iter = parent;
+    }
+    nsIDOMNode_GetNodeType(iter, &type);
+    nsIDOMNode_Release(iter);
+    if(type == DOCUMENT_NODE)
+        return;
+
+    notify_mutation(OBSERVE_CHARACTER_DATA, nsnode, NULL, NULL, FALSE, NULL);
+}
+
+static void mutation_observer_content_changed(DWORD type, void *container, void *child,
+                                              BOOL siblings, BOOL removed, const WCHAR *attr_name)
+{
+    nsIDOMNode *target, *node;
+
+    if(list_empty(&active_observers))
+        return;
+    if(!(target = dom_node_from_content(container)))
+        return;
+    node = dom_node_from_content(child);
+    if(removed)
+        notify_mutation(type, target, attr_name, NULL, FALSE, node);
+    else
+        notify_mutation(type, target, attr_name, node, siblings, NULL);
+    if(node)
+        nsIDOMNode_Release(node);
+    nsIDOMNode_Release(target);
+}
