                       impl_from_IWineMSHTMLMutationObserver(iface)->dispex)
 
+static void free_mutation_record(struct mutation_record *record)
+{
+    UINT i;
+
+    nsIDOMNode_Release(record->target);
+    SysFreeString(record->attr_name);
+    for(i = 0; i < record->added_cnt; i++)
+        nsIDOMNode_Release(record->added[i]);
+    free(record->added);
+    if(record->removed)
+        nsIDOMNode_Release(record->removed);
+    free(record);
+}
+
+static void clear_mutation_records(struct mutation_observer *This)
+{
+    struct mutation_record *record, *next;
+
+    LIST_FOR_EACH_ENTRY_SAFE(record, next, &This->records, struct mutation_record, entry) {
+        list_remove(&record->entry);
+        free_mutation_record(record);
+    }
+}
+
+static void clear_observations(struct mutation_observer *This)
+{
+    UINT i;
+
+    for(i = 0; i < This->observation_cnt; i++)
+        nsIDOMNode_Release(This->observations[i].target);
+    free(This->observations);
+    This->observations = NULL;
+    if(This->observation_cnt) {
+        This->observation_cnt = 0;
+        list_remove(&This->entry);
+        /* drop the reference held while observing */
+        IWineMSHTMLMutationObserver_Release(&This->IWineMSHTMLMutationObserver_iface);
+    }
+}
