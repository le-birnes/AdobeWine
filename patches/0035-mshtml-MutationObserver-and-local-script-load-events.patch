+/* MutationObserver: script changes and Gecko's document notifications produce records
+ * that are delivered asynchronously (through the window's task queue) to the callback.
+ * Polyfills such as core-js schedule their Promise jobs this way, by observing a detached
+ * text node for characterData changes. */
+
+struct observation {
+    nsIDOMNode *target;
+    DWORD flags;
+};
+
+struct mutation_record {
+    struct list entry;
+    DWORD type; /* one of OBSERVE_CHILD_LIST, OBSERVE_ATTRIBUTES, OBSERVE_CHARACTER_DATA */
+    nsIDOMNode *target;
+    BSTR attr_name;
+    nsIDOMNode **added;
+    UINT added_cnt;
+    nsIDOMNode *removed;
+};
+
 struct mutation_observer {
     IWineMSHTMLMutationObserver IWineMSHTMLMutationObserver_iface;
 
     DispatchEx dispex;
     IDispatch *callback;
+
+    HTMLInnerWindow *window;
+    struct observation *observations;
+    UINT observation_cnt;
+    struct list records;
+    struct list entry;      /* in active_observers while observing */
+    BOOL task_pending;
 };
 
+static struct list active_observers = LIST_INIT(active_observers);
+
 static inline struct mutation_observer *impl_from_IWineMSHTMLMutationObserver(IWineMSHTMLMutationObserver *iface)
 {
     return CONTAINING_RECORD(iface, struct mutation_observer, IWineMSHTMLMutationObserver_iface);
@@ -1193,12 +1238,426 @@ static inline struct mutation_observer *impl_from_IWineMSHTMLMutationObserver(IW
