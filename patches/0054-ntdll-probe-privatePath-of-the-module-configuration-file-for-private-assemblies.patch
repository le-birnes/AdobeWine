+/* The application configuration file of a manifest resource: <module>.config for resource 1,
+ * <module>.<id>.config for the others (e.g. foo.dll.2.config). Only its
+ * <probing privatePath="..."/> is used, to find private assemblies in subdirectories. */
+static void load_config_file( ACTIVATION_CONTEXT *actctx, const ACTCTXW *pActCtx )
+{
+    ULONG_PTR id = (ULONG_PTR)pActCtx->lpResourceName;
+    UNICODE_STRING module, nameW;
+    IO_STATUS_BLOCK io;
+    WCHAR *path, *text = NULL, *p, *end;
+    char *data = NULL;
+    ULONG size;
+    HANDLE file;
+
+    if (id >> 16) return;
+    if (pActCtx->dwFlags & ACTCTX_FLAG_HMODULE_VALID)
+    {
+        if (get_module_filename( pActCtx->hModule, &module, 0 )) return;
+    }
+    else if (pActCtx->lpSource && RtlDetermineDosPathNameType_U( pActCtx->lpSource ) != RtlPathTypeRelative)
+    {
+        if (!(module.Buffer = strdupW( pActCtx->lpSource ))) return;
+    }
+    else return;
+
+    size = wcslen( module.Buffer ) + 20;
+    if (!(path = RtlAllocateHeap( GetProcessHeap(), 0, size * sizeof(WCHAR) ))) goto done;
+    if (id == 1) swprintf( path, size, L"%s.config", module.Buffer );
+    else swprintf( path, size, L"%s.%u.config", module.Buffer, (unsigned int)id );
+
+    if (!RtlDosPathNameToNtPathName_U( path, &nameW, NULL, NULL )) goto done;
+    if (open_nt_file( &file, &nameW ))
+    {
+        RtlFreeUnicodeString( &nameW );
+        goto done;
+    }
+    RtlFreeUnicodeString( &nameW );
+    TRACE( "configuration file %s\n", debugstr_w(path) );
+    actctx->config.type = ACTIVATION_CONTEXT_PATH_TYPE_WIN32_FILE;
+    actctx->config.info = path;
+    path = NULL;
+
+    size = 65536;
+    if ((data = RtlAllocateHeap( GetProcessHeap(), 0, size )) &&
+        !NtReadFile( file, 0, NULL, NULL, &io, data, size, NULL, NULL ) &&
+        !RtlUTF8ToUnicodeN( NULL, 0, &size, data, io.Information ) &&
+        (text = RtlAllocateHeap( GetProcessHeap(), 0, size + sizeof(WCHAR) )))
+    {
+        RtlUTF8ToUnicodeN( text, size, &size, data, io.Information );
+        text[size / sizeof(WCHAR)] = 0;
+        if ((p = wcsstr( text, L"<probing" )) && (p = wcsstr( p, L"privatePath" )))
+        {
+            p += wcslen( L"privatePath" );
+            while (*p == ' ' || *p == '\t' || *p == '\r' || *p == '\n') p++;
+            if (*p++ == '=')
+            {
+                while (*p == ' ' || *p == '\t' || *p == '\r' || *p == '\n') p++;
+                if ((*p == '"' || *p == '\'') && (end = wcschr( p + 1, *p )))
+                {
+                    *end = 0;
+                    actctx->private_path = strdupW( p + 1 );
+                    TRACE( "privatePath %s\n", debugstr_w(actctx->private_path) );
+                }
+            }
+        }
+    }
+    NtClose( file );
+
+done:
+    RtlFreeHeap( GetProcessHeap(), 0, text );
+    RtlFreeHeap( GetProcessHeap(), 0, data );
+    RtlFreeHeap( GetProcessHeap(), 0, path );
+    RtlFreeHeap( GetProcessHeap(), 0, module.Buffer );
+}
+
 NTSTATUS WINAPI RtlCreateActivationContext( ACTIVATION_CONTEXT **new_actctx, const void *ptr )
 {
     const ACTCTXW *pActCtx = ptr;  /* FIXME: not the right structure */
@@ -5422,6 +5537,8 @@ NTSTATUS WINAPI RtlCreateActivationContext( ACTIVATION_CONTEXT **new_actctx, con
     if (file) NtClose( file );
     RtlFreeUnicodeString( &nameW );
 
+    if (status == STATUS_SUCCESS && (pActCtx->dwFlags & ACTCTX_FLAG_RESOURCE_NAME_VALID))
+        load_config_file( actctx, pActCtx );
     if (status == STATUS_SUCCESS) status = parse_depend_manifests(&acl);
