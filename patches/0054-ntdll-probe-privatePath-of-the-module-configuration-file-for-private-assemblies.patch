+/* Lookup in <appdir>\<dir>\ and <appdir>\<dir>\name\ for each <dir> of the
+ * configuration file's <probing privatePath="dir1;dir2"/>. */
+static NTSTATUS lookup_private_path( struct actctx_loader *acl, struct assembly_identity *ai,
+                                     const WCHAR *lang, const WCHAR *directory )
+{
+    const WCHAR *appdir = acl->actctx->appdir.info, *dir, *end;
+    NTSTATUS status = STATUS_SXS_ASSEMBLY_NOT_FOUND;
+    DWORD total, len;
+    WCHAR *buffer, *p;
+
+    total = wcslen( appdir ) + wcslen( acl->actctx->private_path ) + 2 * wcslen( ai->name ) + wcslen( lang ) + 14;
+    if (!(buffer = RtlAllocateHeap( GetProcessHeap(), 0, total * sizeof(WCHAR) ))) return STATUS_NO_MEMORY;
+
+    for (dir = acl->actctx->private_path; *dir; dir = *end ? end + 1 : end)
+    {
+        if (!(end = wcschr( dir, ';' ))) end = dir + wcslen( dir );
+        if (end == dir) continue;
+        wcscpy( buffer, appdir );
+        p = buffer + wcslen( buffer );
+        len = end - dir;
+        memcpy( p, dir, len * sizeof(WCHAR) );
+        p += len;
+        *p++ = '\\';
+        *p = 0;
+        TRACE( "probing private path %s\n", debugstr_w(buffer) );
+        status = open_manifest_file( acl, ai, lang, directory, buffer, total );
+        if (status != STATUS_SXS_ASSEMBLY_NOT_FOUND) break;
+
+        swprintf( p, total - (p - buffer), L"%s\\", ai->name );
+        status = open_manifest_file( acl, ai, lang, directory, buffer, total );
+        if (status != STATUS_SXS_ASSEMBLY_NOT_FOUND) break;
+    }
+    RtlFreeHeap( GetProcessHeap(), 0, buffer );
+    return status;
+}
