From: nvb-uy <105564560+nvb-uy@users.noreply.github.com>
Subject: [PATCH] d2d1: Antialias curve fills and strokes with analytic coverage.

Curves were cut with clip() on their implicit function, which multisampling does not smooth
because the shader runs once per pixel. Use g / fwidth(g) as the distance to the edge and
scale the colour by the coverage. Straight segments and plain triangles have a constant g and
keep the old inside test.
Revised 2026-10-29 (AdobeWine): only with D2D1_ANTIALIAS_MODE_PER_PRIMITIVE. In aliased mode the coverage is the old
hard inside test, as Windows draws it: the first version also smoothed aliased curves, which alone made 94 checks of
Wine's d2d1 tests fail (test_fill_geometry, test_draw_geometry, test_path_geometry, test_bezier_intersect all draw
aliased). The pixel shader gets the mode in the constant buffer slot that was padding. d2d1 tests now 0 failures on
both arches.
---
--- a/dlls/d2d1/device.c
+++ b/dlls/d2d1/device.c
@@ -1016,8 +1016,8 @@
     cb_data = map_desc.pData;
     cb_data->outline = outline;
     cb_data->is_arc = is_arc;
-    cb_data->pad[0] = 0;
-    cb_data->pad[1] = 0;
+    cb_data->aliased = context->drawing_state.antialiasMode == D2D1_ANTIALIAS_MODE_ALIASED;
+    cb_data->pad = 0;
     if (!d2d_brush_fill_cb(brush, &cb_data->colour_brush))
         WARN("Failed to initialize colour brush buffer.\n");
     if (!d2d_brush_fill_cb(opacity_brush, &cb_data->opacity_brush))
@@ -4498,6 +4498,7 @@
     "\n"
     "bool outline;\n"
     "bool is_arc;\n"
+    "bool aliased;\n"
     "struct brush\n"
     "{\n"
     "    uint type;\n"
@@ -4630,6 +4631,7 @@
     "float4 main(struct input i) : SV_Target\n"
     "{\n"
     "    float4 colour;\n"
+    "    float g, fw, coverage;\n"
     "\n"
     "    colour = sample_brush(colour_brush, t0, s0, b0, i.p);\n"
     "    if (opacity_brush.type < BRUSH_TYPE_COUNT)\n"
@@ -4666,14 +4668,14 @@
     "            df = 2.0f * uv.x * du - dv;\n"
     "\n"
     "            clip(dot(df, uv.zw));\n"
-    "            clip(length(mul(i.stroke_transform, df)) - abs(uv.x * uv.x - uv.y));\n"
+    "            g = length(mul(i.stroke_transform, df)) - abs(uv.x * uv.x - uv.y);\n"
     "        }\n"
     "        else\n"
     "        {\n"
     "            df = 2.0f * uv.x * du + 2.0f * uv.y * dv;\n"
     "\n"
     "            clip(dot(df, uv.zw));\n"
-    "            clip(length(mul(i.stroke_transform, df)) - abs(uv.x * uv.x + uv.y * uv.y - 1.0f));\n"
+    "            g = length(mul(i.stroke_transform, df)) - abs(uv.x * uv.x + uv.y * uv.y - 1.0f);\n"
     "        }\n"
     "    }\n"
     "    else\n"
@@ -4682,15 +4684,20 @@
     "         * \"i.b.z\" determines which side of the curve is shaded. */\n"
     "        if (!is_arc)\n"
     "        {\n"
-    "            clip((i.b.x * i.b.x - i.b.y) * i.b.z);\n"
+    "            g = (i.b.x * i.b.x - i.b.y) * i.b.z;\n"
     "        }\n"
     "        else\n"
     "        {\n"
-    "            clip((i.b.x * i.b.x + i.b.y * i.b.y - 1.0) * i.b.z);\n"
+    "            g = (i.b.x * i.b.x + i.b.y * i.b.y - 1.0) * i.b.z;\n"
     "        }\n"
     "    }\n"
     "\n"
-    "    return colour;\n"
+    "    fw = fwidth(g);\n"
+    "    coverage = fw > 0.0f ? saturate(0.5f + g / fw) : (g >= 0.0f ? 1.0f : 0.0f);\n"
+    "    /* D2D1_ANTIALIAS_MODE_ALIASED: hard edges, as Windows draws them */\n"
+    "    if (aliased) coverage = g >= 0.0f ? 1.0f : 0.0f;\n"
+    "    clip(coverage - 1.0f / 512.0f);\n"
+    "    return colour * coverage;\n"
     "}\n";
 static const struct shape_info
 {
--- a/dlls/d2d1/d2d1_private.h
+++ b/dlls/d2d1/d2d1_private.h
@@ -120,7 +120,8 @@
 {
     BOOL outline;
     BOOL is_arc;
-    BOOL pad[2];
+    BOOL aliased;
+    BOOL pad;
     struct d2d_brush_cb colour_brush;
     struct d2d_brush_cb opacity_brush;
 };
