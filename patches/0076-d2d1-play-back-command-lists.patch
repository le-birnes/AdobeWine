+static void d2d_device_context_draw_command_list(struct d2d_device_context *context, ID2D1CommandList *command_list,
+        const D2D1_POINT_2F *target_offset, const D2D1_RECT_F *image_rect)
+{
+    ID2D1DeviceContext *iface = (ID2D1DeviceContext *)&context->ID2D1DeviceContext6_iface;
+    struct d2d_command_list_player player;
+    D2D1_PRIMITIVE_BLEND blend;
+    D2D1_ANTIALIAS_MODE mode;
+    D2D1_UNIT_MODE unit_mode;
+    D2D1_MATRIX_3X2_F transform;
+
+    player.ID2D1CommandSink_iface.lpVtbl = &d2d_command_list_player_vtbl;
+    player.context = iface;
+    ID2D1DeviceContext_GetTransform(iface, &transform);
+    player.base = transform;
+    if (target_offset)
+    {
+        player.base._31 += target_offset->x * transform._11 + target_offset->y * transform._21;
+        player.base._32 += target_offset->x * transform._12 + target_offset->y * transform._22;
+    }
+    mode = ID2D1DeviceContext_GetAntialiasMode(iface);
+    blend = ID2D1DeviceContext_GetPrimitiveBlend(iface);
+    unit_mode = ID2D1DeviceContext_GetUnitMode(iface);
+
+    if (image_rect)
+    {
+        ID2D1DeviceContext_SetTransform(iface, &player.base);
+        ID2D1DeviceContext_PushAxisAlignedClip(iface, image_rect, mode);
+    }
+    ID2D1DeviceContext_SetTransform(iface, &player.base);
+    ID2D1CommandList_Stream(command_list, &player.ID2D1CommandSink_iface);
+    if (image_rect)
+    {
+        ID2D1DeviceContext_SetTransform(iface, &player.base);
+        ID2D1DeviceContext_PopAxisAlignedClip(iface);
+    }
+
+    ID2D1DeviceContext_SetTransform(iface, &transform);
+    ID2D1DeviceContext_SetAntialiasMode(iface, mode);
+    ID2D1DeviceContext_SetPrimitiveBlend(iface, blend);
+    ID2D1DeviceContext_SetUnitMode(iface, unit_mode);
+}
+
 static void STDMETHODCALLTYPE d2d_device_context_DrawImage(ID2D1DeviceContext6 *iface, ID2D1Image *image,
         const D2D1_POINT_2F *target_offset, const D2D1_RECT_F *image_rect, D2D1_INTERPOLATION_MODE interpolation_mode,
         D2D1_COMPOSITE_MODE composite_mode)
 {
     struct d2d_device_context *context = impl_from_ID2D1DeviceContext(iface);
+    ID2D1CommandList *command_list;
     ID2D1Bitmap *bitmap;
 
     TRACE("iface %p, image %p, target_offset %s, image_rect %s, interpolation_mode %#x, composite_mode %#x.\n",
@@ -2984,6 +3250,13 @@ static void STDMETHODCALLTYPE d2d_device_context_DrawImage(ID2D1DeviceContext6 *
         return;
     }
 
+    if (SUCCEEDED(ID2D1Image_QueryInterface(image, &IID_ID2D1CommandList, (void **)&command_list)))
+    {
+        d2d_device_context_draw_command_list(context, command_list, target_offset, image_rect);
+        ID2D1CommandList_Release(command_list);
+        return;
+    }
+
     FIXME("Unhandled image %p.\n", image);
 }
 
