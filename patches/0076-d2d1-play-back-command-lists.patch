d2d1: Play command lists back in DrawImage(), and let EndDraw() succeed on a command list target.

After Effects draws its panels (Drawbot) into command lists and then draws those with DrawImage().
EndDraw() on the command list target returned E_NOTIMPL, which After Effects reported as
"Direct2D Drawbot error" on every redraw, and DrawImage() ignored command list images ("Unhandled
image"). A small ID2D1CommandSink now replays a closed list through ID2D1CommandList_Stream() into
the device context, with the recorded transforms applied on top of the current transform and
target offset, clipped to image_rect, and the context's transform, antialias mode, primitive
blend and unit mode restored afterwards. The After Effects panels draw again.

diff --git a/dlls/d2d1/device.c b/dlls/d2d1/device.c
index 4a8014c..4a438c3 100644
--- a/dlls/d2d1/device.c
+++ b/dlls/d2d1/device.c
@@ -2305,8 +2305,12 @@ static HRESULT STDMETHODCALLTYPE d2d_device_context_EndDraw(ID2D1DeviceContext6
 
     if (context->target.type == D2D_TARGET_COMMAND_LIST)
     {
-        FIXME("Unimplemented for command list target.\n");
-        return E_NOTIMPL;
+        /* the commands are recorded as they are issued; the list is finished by Close() */
+        if (tag1)
+            *tag1 = context->error.tag1;
+        if (tag2)
+            *tag2 = context->error.tag2;
+        return context->error.code;
     }
 
     if (tag1)
@@ -2946,11 +2950,273 @@ static void STDMETHODCALLTYPE d2d_device_context_ID2D1DeviceContext_DrawGlyphRun
     d2d_device_context_draw_glyph_run(context, baseline_origin, glyph_run, glyph_run_desc, brush, measuring_mode);
 }
 
+/* Plays a closed command list back into a device context, for DrawImage() with a command list. */
+struct d2d_command_list_player
+{
+    ID2D1CommandSink ID2D1CommandSink_iface;
+    ID2D1DeviceContext *context;
+    D2D1_MATRIX_3X2_F base;
+};
+
+static inline struct d2d_command_list_player *impl_from_ID2D1CommandSink(ID2D1CommandSink *iface)
+{
+    return CONTAINING_RECORD(iface, struct d2d_command_list_player, ID2D1CommandSink_iface);
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_player_QueryInterface(ID2D1CommandSink *iface, REFIID iid, void **out)
+{
+    if (IsEqualGUID(iid, &IID_ID2D1CommandSink) || IsEqualGUID(iid, &IID_IUnknown))
+    {
+        ID2D1CommandSink_AddRef(*(ID2D1CommandSink **)out = iface);
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG STDMETHODCALLTYPE d2d_player_AddRef(ID2D1CommandSink *iface) { return 2; }
+static ULONG STDMETHODCALLTYPE d2d_player_Release(ID2D1CommandSink *iface) { return 1; }
+static HRESULT STDMETHODCALLTYPE d2d_player_BeginDraw(ID2D1CommandSink *iface) { return S_OK; }
+static HRESULT STDMETHODCALLTYPE d2d_player_EndDraw(ID2D1CommandSink *iface) { return S_OK; }
+
+static HRESULT STDMETHODCALLTYPE d2d_player_SetAntialiasMode(ID2D1CommandSink *iface, D2D1_ANTIALIAS_MODE mode)
+{
+    ID2D1DeviceContext_SetAntialiasMode(impl_from_ID2D1CommandSink(iface)->context, mode);
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_player_SetTags(ID2D1CommandSink *iface, D2D1_TAG tag1, D2D1_TAG tag2)
