+static pthread_once_t user_mutex_once = PTHREAD_ONCE_INIT;
 static unsigned int user_lock_thread, user_lock_rec;
 
 static UINT gcd( UINT a, UINT b )
@@ -331,8 +342,20 @@
     return x.num * y.den <= y.num * x.den ? x : y;
 }
 
+/* initialized on first use: processes can get here before user32 initializes (sysparams_init) */
+static void init_user_mutex(void)
+{
+    pthread_mutexattr_t attr;
+
+    pthread_mutexattr_init( &attr );
+    pthread_mutexattr_settype( &attr, PTHREAD_MUTEX_RECURSIVE );
+    pthread_mutex_init( &user_mutex, &attr );
+    pthread_mutexattr_destroy( &attr );
+}
+
 void user_lock(void)
 {
+    pthread_once( &user_mutex_once, init_user_mutex );
     pthread_mutex_lock( &user_mutex );
     if (!user_lock_rec++) user_lock_thread = GetCurrentThreadId();
 }
