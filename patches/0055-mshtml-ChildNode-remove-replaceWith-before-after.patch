+sync_test("ChildNode", function() {
+    var div = document.createElement("div"), a, b, c, t, r;
+
+    if(!("replaceWith" in Element.prototype)) {
+        win_skip("ChildNode methods not supported");
+        return;
+    }
+
+    function children_str(node) {
+        var ret = [], n;
+        for(n = node.firstChild; n; n = n.nextSibling)
+            ret.push(n.nodeType === 3 ? "#" + n.data : n.id);
+        return ret.join();
+    }
+
+    ok(Element.prototype.hasOwnProperty("remove"), "remove not an own prop of Element.prototype");
+    ok(Element.prototype.hasOwnProperty("replaceWith"), "replaceWith not an own prop of Element.prototype");
+    ok(Element.prototype.hasOwnProperty("before"), "before not an own prop of Element.prototype");
+    ok(Element.prototype.hasOwnProperty("after"), "after not an own prop of Element.prototype");
+    ok(CharacterData.prototype.hasOwnProperty("remove"), "remove not an own prop of CharacterData.prototype");
+    ok(DocumentType.prototype.hasOwnProperty("after"), "after not an own prop of DocumentType.prototype");
+    ok(!Node.prototype.hasOwnProperty("remove"), "remove is an own prop of Node.prototype");
+    ok(!("before" in document), "before in document");
+    ok(!("after" in document.createDocumentFragment()), "after in document fragment");
+
+    a = document.createElement("span"); a.id = "a";
