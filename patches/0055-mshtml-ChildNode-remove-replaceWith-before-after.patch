diff --git a/dlls/mshtml/htmlnode.c b/dlls/mshtml/htmlnode.c
index 7a43f19..6573353 100644
--- a/dlls/mshtml/htmlnode.c
+++ b/dlls/mshtml/htmlnode.c
@@ -1108,6 +1108,337 @@ static const IWineHTMLDOMNodePrivateVtbl HTMLDOMNode_private_vtbl = {
     HTMLDOMNode_private_normalize,
 };
 
+enum child_node_insert {
+    CHILD_NODE_BEFORE,
+    CHILD_NODE_AFTER,
+    CHILD_NODE_REPLACE_WITH
+};
+
+/* Converts an argument of ChildNode methods to a Gecko node: nodes are used as they are,
+ * anything else is converted to a string and becomes a new text node. */
+static HRESULT child_node_arg_to_nsnode(nsIDOMDocument *nsdoc, VARIANT *arg, IServiceProvider *caller,
+                                        nsIDOMNode **ret)
+{
+    nsIDOMText *nstext;
+    nsAString str;
+    VARIANT bstr;
+    nsresult nsres;
+    HRESULT hres;
+
+    if(V_VT(arg) == VT_DISPATCH && V_DISPATCH(arg)) {
+        IHTMLDOMNode *node_iface;
+        HTMLDOMNode *node;
+
+        hres = IDispatch_QueryInterface(V_DISPATCH(arg), &IID_IHTMLDOMNode, (void**)&node_iface);
+        if(SUCCEEDED(hres)) {
+            node = get_node_obj(node_iface);
+            IHTMLDOMNode_Release(node_iface);
+            if(node) {
+                nsIDOMNode_AddRef(node->nsnode);
+                *ret = node->nsnode;
+                node_release(node);
+                return S_OK;
+            }
+        }
+    }
+
+    switch(V_VT(arg)) {
+    case VT_EMPTY:
+        V_VT(&bstr) = VT_BSTR;
+        V_BSTR(&bstr) = SysAllocString(L"undefined");
+        break;
+    case VT_NULL:
+        V_VT(&bstr) = VT_BSTR;
+        V_BSTR(&bstr) = SysAllocString(L"null");
+        break;
+    case VT_BSTR:
+        V_VT(&bstr) = VT_BSTR;
+        V_BSTR(&bstr) = SysAllocStringLen(V_BSTR(arg), SysStringLen(V_BSTR(arg)));
+        break;
+    default:
+        hres = change_type(&bstr, arg, VT_BSTR, caller);
+        if(FAILED(hres))
+            return hres;
+    }
+    if(!V_BSTR(&bstr))
+        return E_OUTOFMEMORY;
+
+    nsAString_InitDepend(&str, V_BSTR(&bstr));
+    nsres = nsIDOMDocument_CreateTextNode(nsdoc, &str, &nstext);
+    nsAString_Finish(&str);
+    VariantClear(&bstr);
+    if(NS_FAILED(nsres)) {
+        ERR("CreateTextNode failed: %08lx\n", nsres);
+        return map_nsresult(nsres);
+    }
+
+    *ret = (nsIDOMNode*)nstext;
+    return S_OK;
+}
+
+static BOOL is_node_in_list(nsIDOMNode *node, nsIDOMNode **nodes, unsigned count)
+{
+    unsigned i;
+
+    for(i = 0; i < count; i++) {
+        if(nodes[i] == node)
+            return TRUE;
+    }
+    return FALSE;
+}
+
+/* Returns the first sibling of node in the given direction that is not in nodes, or NULL. */
+static nsIDOMNode *get_viable_sibling(nsIDOMNode *node, BOOL next, nsIDOMNode **nodes, unsigned count)
+{
+    nsIDOMNode *sibling = NULL, *tmp;
+
+    if(next)
+        nsIDOMNode_GetNextSibling(node, &sibling);
+    else
+        nsIDOMNode_GetPreviousSibling(node, &sibling);
+
+    while(sibling && is_node_in_list(sibling, nodes, count)) {
+        tmp = sibling;
+        sibling = NULL;
+        if(next)
+            nsIDOMNode_GetNextSibling(tmp, &sibling);
+        else
+            nsIDOMNode_GetPreviousSibling(tmp, &sibling);
+        nsIDOMNode_Release(tmp);
+    }
+
+    return sibling;
+}
+
+/*
+ * Implements ChildNode.before(), after() and replaceWith() as described in the DOM spec.
+ * args are in DISPPARAMS order, that is the last argument comes first.
+ */
+static HRESULT child_node_insert(HTMLDOMNode *This, enum child_node_insert where, VARIANT *args, unsigned argc,
+                                 IServiceProvider *caller)
+{
+    nsIDOMNode *parent = NULL, *sibling = NULL, *node = NULL, *tmp, **nodes = NULL;
+    nsIDOMDocumentFragment *fragment;
+    nsIDOMDocument *nsdoc = NULL;
+    unsigned i, count = 0;
+    nsresult nsres;
+    HRESULT hres = S_OK;
+
+    nsres = nsIDOMNode_GetParentNode(This->nsnode, &parent);
+    if(NS_FAILED(nsres))
+        return map_nsresult(nsres);
+    if(!parent)
+        return S_OK;
+
+    nsres = nsIDOMNode_GetOwnerDocument(This->nsnode, &nsdoc);
+    if(NS_FAILED(nsres) || !nsdoc) {
+        ERR("GetOwnerDocument failed: %08lx\n", nsres);
+        nsIDOMNode_Release(parent);
+        return E_FAIL;
+    }
+
+    if(argc && !(nodes = malloc(argc * sizeof(*nodes)))) {
+        hres = E_OUTOFMEMORY;
+        goto done;
+    }
+    for(count = 0; count < argc; count++) {
+        hres = child_node_arg_to_nsnode(nsdoc, &args[argc - count - 1], caller, &nodes[count]);
+        if(FAILED(hres))
+            goto done;
+    }
+
+    /* for before(), this is the viable previous sibling until the nodes are moved */
+    sibling = get_viable_sibling(This->nsnode, where != CHILD_NODE_BEFORE, nodes, count);
+
+    if(count == 1) {
+        node = nodes[0];
+        nsIDOMNode_AddRef(node);
+    }else {
+        nsres = nsIDOMDocument_CreateDocumentFragment(nsdoc, &fragment);
+        if(NS_FAILED(nsres)) {
+            ERR("CreateDocumentFragment failed: %08lx\n", nsres);
+            hres = map_nsresult(nsres);
+            goto done;
+        }
+        node = (nsIDOMNode*)fragment;
+
+        for(i = 0; i < count; i++) {
+            nsres = nsIDOMNode_AppendChild(node, nodes[i], &tmp);
+            if(NS_FAILED(nsres)) {
+                WARN("AppendChild failed: %08lx\n", nsres);
+                hres = map_nsresult(nsres);
+                goto done;
+            }
+            nsIDOMNode_Release(tmp);
+        }
+    }
+
+    if(where == CHILD_NODE_BEFORE) {
+        tmp = sibling;
+        sibling = NULL;
+        if(tmp) {
+            nsIDOMNode_GetNextSibling(tmp, &sibling);
+            nsIDOMNode_Release(tmp);
+        }else {
+            nsIDOMNode_GetFirstChild(parent, &sibling);
+        }
+    }
+
+    tmp = NULL;
+    if(where == CHILD_NODE_REPLACE_WITH) {
+        nsIDOMNode *cur_parent = NULL;
+
+        nsIDOMNode_GetParentNode(This->nsnode, &cur_parent);
+        if(cur_parent == parent)
+            nsres = nsIDOMNode_ReplaceChild(parent, node, This->nsnode, &tmp);
+        else
+            nsres = nsIDOMNode_InsertBefore(parent, node, sibling, &tmp);
+        if(cur_parent)
+            nsIDOMNode_Release(cur_parent);
+    }else {
+        nsres = nsIDOMNode_InsertBefore(parent, node, sibling, &tmp);
+    }
+    if(NS_FAILED(nsres)) {
+        WARN("insert failed: %08lx\n", nsres);
+        hres = map_nsresult(nsres);
+    }else if(tmp) {
+        nsIDOMNode_Release(tmp);
+    }
+
+done:
+    for(i = 0; i < count; i++)
+        nsIDOMNode_Release(nodes[i]);
+    free(nodes);
+    if(node)
+        nsIDOMNode_Release(node);
+    if(sibling)
+        nsIDOMNode_Release(sibling);
+    nsIDOMDocument_Release(nsdoc);
+    nsIDOMNode_Release(parent);
+    return hres;
+}
+
+static inline HTMLDOMNode *impl_from_IWineHTMLChildNode(IWineHTMLChildNode *iface)
+{
+    return CONTAINING_RECORD(iface, HTMLDOMNode, IWineHTMLChildNode_iface);
+}
+
+DISPEX_IDISPATCH_IMPL(ChildNode, IWineHTMLChildNode, impl_from_IWineHTMLChildNode(iface)->event_target.dispex)
+
+static HRESULT WINAPI ChildNode_remove(IWineHTMLChildNode *iface)
+{
+    HTMLDOMNode *This = impl_from_IWineHTMLChildNode(iface);
+    nsIDOMNode *parent, *removed;
+    nsresult nsres;
+
+    TRACE("(%p)\n", This);
+
+    nsres = nsIDOMNode_GetParentNode(This->nsnode, &parent);
+    if(NS_FAILED(nsres))
+        return map_nsresult(nsres);
+    if(!parent)
+        return S_OK;
+
+    nsres = nsIDOMNode_RemoveChild(parent, This->nsnode, &removed);
+    nsIDOMNode_Release(parent);
+    if(NS_FAILED(nsres)) {
+        ERR("RemoveChild failed: %08lx\n", nsres);
+        return map_nsresult(nsres);
+    }
+
+    nsIDOMNode_Release(removed);
+    return S_OK;
+}
+
+static HRESULT WINAPI ChildNode_replaceWith(IWineHTMLChildNode *iface, VARIANT node)
+{
+    HTMLDOMNode *This = impl_from_IWineHTMLChildNode(iface);
+
+    TRACE("(%p)->(%s)\n", This, debugstr_variant(&node));
+
+    return child_node_insert(This, CHILD_NODE_REPLACE_WITH, &node, 1, NULL);
+}
+
+static HRESULT WINAPI ChildNode_before(IWineHTMLChildNode *iface, VARIANT node)
+{
+    HTMLDOMNode *This = impl_from_IWineHTMLChildNode(iface);
+
+    TRACE("(%p)->(%s)\n", This, debugstr_variant(&node));
+
+    return child_node_insert(This, CHILD_NODE_BEFORE, &node, 1, NULL);
+}
+
+static HRESULT WINAPI ChildNode_after(IWineHTMLChildNode *iface, VARIANT node)
+{
+    HTMLDOMNode *This = impl_from_IWineHTMLChildNode(iface);
+
+    TRACE("(%p)->(%s)\n", This, debugstr_variant(&node));
+
+    return child_node_insert(This, CHILD_NODE_AFTER, &node, 1, NULL);
+}
+
+static const IWineHTMLChildNodeVtbl ChildNodeVtbl = {
+    ChildNode_QueryInterface,
+    ChildNode_AddRef,
+    ChildNode_Release,
+    ChildNode_GetTypeInfoCount,
+    ChildNode_GetTypeInfo,
+    ChildNode_GetIDsOfNames,
+    ChildNode_Invoke,
+    ChildNode_remove,
+    ChildNode_replaceWith,
+    ChildNode_before,
+    ChildNode_after,
+};
+
+/* The methods take any number of arguments, which the IDL can't express. */
+static HRESULT child_node_hook(DispatchEx *dispex, enum child_node_insert where, WORD flags, DISPPARAMS *dp,
+                               VARIANT *res, IServiceProvider *caller)
+{
+    HTMLDOMNode *This = CONTAINING_RECORD(dispex, HTMLDOMNode, event_target.dispex);
+
+    if(!(flags & DISPATCH_METHOD) || dp->cNamedArgs)
+        return S_FALSE;
+
+    TRACE("(%p)->(%u args)\n", This, dp->cArgs);
+
+    if(res)
+        V_VT(res) = VT_EMPTY;
+    return child_node_insert(This, where, dp->rgvarg, dp->cArgs, caller);
+}
+
+static HRESULT ChildNode_replaceWith_hook(DispatchEx *dispex, WORD flags, DISPPARAMS *dp, VARIANT *res,
+                                          EXCEPINFO *ei, IServiceProvider *caller)
+{
+    return child_node_hook(dispex, CHILD_NODE_REPLACE_WITH, flags, dp, res, caller);
+}
+
+static HRESULT ChildNode_before_hook(DispatchEx *dispex, WORD flags, DISPPARAMS *dp, VARIANT *res,
+                                     EXCEPINFO *ei, IServiceProvider *caller)
+{
+    return child_node_hook(dispex, CHILD_NODE_BEFORE, flags, dp, res, caller);
+}
+
+static HRESULT ChildNode_after_hook(DispatchEx *dispex, WORD flags, DISPPARAMS *dp, VARIANT *res,
+                                    EXCEPINFO *ei, IServiceProvider *caller)
+{
+    return child_node_hook(dispex, CHILD_NODE_AFTER, flags, dp, res, caller);
+}
+
+/* ChildNode members of Element, CharacterData and DocumentType. */
+void ChildNode_init_dispex_info(dispex_data_t *info, compat_mode_t mode)
+{
+    static const dispex_hook_t child_node_hooks[] = {
+        {DISPID_IWINEHTMLCHILDNODE_REPLACEWITH, ChildNode_replaceWith_hook},
+        {DISPID_IWINEHTMLCHILDNODE_BEFORE,      ChildNode_before_hook},
+        {DISPID_IWINEHTMLCHILDNODE_AFTER,       ChildNode_after_hook},
+        {DISPID_UNKNOWN}
+    };
+
+    if(mode >= COMPAT_MODE_IE9)
+        dispex_info_add_interface(info, IWineHTMLChildNode_tid, child_node_hooks);
+}
