+static HRESULT WINAPI stream_reference_OpenReadAsync( IRandomAccessStreamReference *iface,
+        IAsyncOperation_IRandomAccessStreamWithContentType **operation )
+{
+    struct stream_reference *impl = impl_from_stream_reference( iface );
+    struct open_read_operation *op;
+    IRandomAccessStream *clone;
+    HRESULT hr;
+
+    TRACE( "iface %p, operation %p.\n", iface, operation );
+
+    *operation = NULL;
+    if (FAILED(hr = IRandomAccessStream_CloneStream( impl->stream, &clone ))) return hr;
+    if (!(op = calloc( 1, sizeof(*op) )))
+    {
+        IRandomAccessStream_Release( clone );
+        return E_OUTOFMEMORY;
+    }
+    op->IAsyncOperation_IRandomAccessStreamWithContentType_iface.lpVtbl = &open_read_vtbl;
+    op->IAsyncInfo_iface.lpVtbl = &open_read_info_vtbl;
+    op->ref = 1;
+    hr = IRandomAccessStream_QueryInterface( clone, &IID_IRandomAccessStreamWithContentType, (void **)&op->result );
+    IRandomAccessStream_Release( clone );
+    if (FAILED(hr))
+    {
+        free( op );
+        return hr;
+    }
+    *operation = &op->IAsyncOperation_IRandomAccessStreamWithContentType_iface;
+    return S_OK;
+}
