+/* Clones share nothing with the original here: a copy of the data, position 0. */
+static HRESULT memory_stream_clone( struct memory_stream *impl, IRandomAccessStream **out )
+{
+    struct memory_stream *clone;
+    HRESULT hr;
+
+    if (FAILED(hr = memory_stream_create( out ))) return hr;
+    clone = impl_from_IRandomAccessStream( *out );
+    if (impl->size)
+    {
+        if (FAILED(hr = memory_stream_require_capacity( clone, impl->size )))
+        {
+            IRandomAccessStream_Release( *out );
+            *out = NULL;
+            return hr;
+        }
+        memcpy( clone->buffer, impl->buffer, impl->size );
+        clone->size = impl->size;
+    }
+    return S_OK;
+}
