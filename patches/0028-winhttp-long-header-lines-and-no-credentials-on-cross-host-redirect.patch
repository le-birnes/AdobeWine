-#define MAX_REPLY_LEN   1460
+/* Longest status or header line accepted. Was 1460, which cut long Location headers
+ * (presigned S3/CloudFront URLs of ~1.5 kB used by Adobe's model downloads); Windows
+ * accepts much longer lines. */
+#define MAX_REPLY_LEN   65536
 #define INITIAL_HEADER_BUFFER_LEN  512
 
+static DWORD read_reply_buffer( struct request *request, char *buffer );
+
 static DWORD read_reply( struct request *request )
 {
-    char buffer[MAX_REPLY_LEN];
+    char *buffer = malloc( MAX_REPLY_LEN );
+    DWORD ret;
+
+    if (!buffer) return ERROR_OUTOFMEMORY;
+    ret = read_reply_buffer( request, buffer );
+    free( buffer );
+    return ret;
+}
+
+static DWORD read_reply_buffer( struct request *request, char *buffer )
+{
     DWORD ret, buflen, len, offset, crlf_len = 2; /* lstrlenW(crlf) */
     const char *status_text, *ptr;
     WCHAR *versionW, *status_textW, *raw_headers;
@@ -3146,6 +3161,15 @@ static DWORD handle_redirect( struct request *request, DWORD status )
             request->netconn = NULL;
             request->content_length = request->content_read = 0;
             reset_data_stream( request );
+
+            /* Like Windows, do not forward credentials to another host: presigned storage
+             * URLs (S3 / CloudFront, used by Adobe's model downloads) reject a request that
+             * also carries an Authorization header with HTTP 400. */
+            {
+                int index;
+                while ((index = get_header_index( request, L"Authorization", 0, TRUE )) >= 0)
