diff --git a/dlls/winex11.drv/mouse.c b/dlls/winex11.drv/mouse.c
index cb79ed5..cae3366 100644
--- a/dlls/winex11.drv/mouse.c
+++ b/dlls/winex11.drv/mouse.c
@@ -352,6 +352,207 @@ void x11drv_xinput2_enable( Display *display, Window window )
 }
 
 
+static struct
+{
+    int deviceid;
+    BOOL is_tablet;          /* (floating) slave pointer with a pressure axis */
+    BOOL eraser;
+    double min[5], max[5];
+    double value[5];         /* last raw value of each axis */
+    unsigned int buttons;
+} tablet_ranges[32];
+
+/* find or add the state of a device; ranges and kind are queried the first time */
+static int query_tablet_ranges( Display *display, int deviceid )
+{
+    XIDeviceInfo *info;
+    int i, j, count, slot = -1;
+
+    for (i = 0; i < ARRAY_SIZE(tablet_ranges); i++)
+    {
+        if (tablet_ranges[i].deviceid == deviceid) return i;
+        if (slot < 0 && !tablet_ranges[i].deviceid) slot = i;
+    }
+    if (slot < 0 || !(info = pXIQueryDevice( display, deviceid, &count ))) return -1;
+
+    tablet_ranges[slot].deviceid = deviceid;
+    for (i = 0; i < info->num_classes; i++)
+    {
+        XIValuatorClassInfo *valuator = (XIValuatorClassInfo *)info->classes[i];
+        char *label;
+
+        if (info->classes[i]->type != XIValuatorClass) continue;
+        if ((j = valuator->number) >= ARRAY_SIZE(tablet_ranges[slot].min)) continue;
+        tablet_ranges[slot].min[j] = valuator->min;
+        tablet_ranges[slot].max[j] = valuator->max;
+        if (j == 2 && (info->use == XISlavePointer || info->use == XIFloatingSlave) && valuator->label &&
+            (label = XGetAtomName( display, valuator->label )))
+        {
+            tablet_ranges[slot].is_tablet = strstr( label, "Pressure" ) != NULL;
+            XFree( label );
+        }
+        TRACE( "device %d axis %d range %f-%f\n", deviceid, j, valuator->min, valuator->max );
+    }
+    tablet_ranges[slot].eraser = info->name && strstr( info->name, "eraser" );
+    TRACE( "device %d %s: tablet %d eraser %d\n", deviceid, debugstr_a(info->name),
+           tablet_ranges[slot].is_tablet, tablet_ranges[slot].eraser );
+    pXIFreeDeviceInfo( info );
+    return slot;
+}
+
+/* select raw events of the pen devices on the root window, so pen input reaches applications
+ * as pointer messages (Windows Ink) whether or not they use wintab; rescanned when devices change */
+static Display *tablet_display;
+
+static void select_tablet_raw_events( Display *display )
+{
+    static LONG selected;
+    unsigned char mask_bits[XIMaskLen(XI_LASTEVENT)], hier_bits[XIMaskLen(XI_LASTEVENT)];
+    XIEventMask mask, hier;
+    XIDeviceInfo *info;
+    int i, count, slot;
+
+    if (!InterlockedExchange( &selected, 1 ))
+    {
+        tablet_display = display;
+        hier.mask     = hier_bits;
+        hier.mask_len = sizeof(hier_bits);
+        hier.deviceid = XIAllDevices;
+        memset( hier_bits, 0, sizeof(hier_bits) );
+        XISetMask( hier_bits, XI_HierarchyChanged );
+        pXISelectEvents( display, DefaultRootWindow( display ), &hier, 1 );
+    }
+    if (display != tablet_display) return;
+    if (!(info = pXIQueryDevice( display, XIAllDevices, &count ))) return;
+
+    for (i = 0; i < count; i++)
+    {
+        if (info[i].use != XISlavePointer && info[i].use != XIFloatingSlave) continue;
+        if ((slot = query_tablet_ranges( display, info[i].deviceid )) < 0 || !tablet_ranges[slot].is_tablet) continue;
+
+        mask.mask     = mask_bits;
+        mask.mask_len = sizeof(mask_bits);
+        mask.deviceid = info[i].deviceid;
+        memset( mask_bits, 0, sizeof(mask_bits) );
+        XISetMask( mask_bits, XI_RawMotion );
+        XISetMask( mask_bits, XI_RawButtonPress );
+        XISetMask( mask_bits, XI_RawButtonRelease );
+        pXISelectEvents( display, DefaultRootWindow( display ), &mask, 1 );
+    }
+    pXIFreeDeviceInfo( info );
+}
+
+/* send pen pointer messages for the window under the cursor if this process owns it; a window
+ * that got the pen down keeps it until the pen is lifted (pointer capture) */
+static void send_pen_pointer( int slot, unsigned int prev_buttons )
+{
+    static const UINT32 pen_id = 0x10;
+    static HWND contact_hwnd;
+    INPUT input = {.type = INPUT_HARDWARE};
+    double *value = tablet_ranges[slot].value, *min = tablet_ranges[slot].min, *max = tablet_ranges[slot].max;
+    BOOL contact = tablet_ranges[slot].buttons & 1, pressed = contact && !(prev_buttons & 1);
+    UINT64 data;
+    DWORD pid = 0;
+    POINT pt;
+    HWND hwnd;
+    int i, n[5];
+
+    for (i = 0; i < 5; i++)
+        n[i] = max[i] > min[i] ? (value[i] - min[i]) * 65535 / (max[i] - min[i]) : 0;
+
+    if (!(hwnd = contact_hwnd))
+    {
+        /* a stroke that started over another process's window belongs to it */
+        if (contact && !pressed) return;
+        if (!NtUserGetCursorPos( &pt ) || !(hwnd = NtUserWindowFromPoint( pt.x, pt.y ))) return;
+        NtUserGetWindowThread( hwnd, &pid );
+        if (pid != GetCurrentProcessId()) return;
+    }
+
+    input.hi.uMsg = contact ? (contact_hwnd ? WM_POINTERUPDATE : WM_POINTERDOWN)
+                            : (contact_hwnd ? WM_POINTERUP : WM_POINTERUPDATE);
+    input.hi.wParamL = pen_id;
+    input.hi.wParamH = POINTER_MESSAGE_FLAG_INRANGE | WINE_POINTER_MESSAGE_FLAG_PEN;
+    if (contact) input.hi.wParamH |= POINTER_MESSAGE_FLAG_INCONTACT | POINTER_MESSAGE_FLAG_FIRSTBUTTON;
+    if (contact && !contact_hwnd) input.hi.wParamH |= POINTER_MESSAGE_FLAG_NEW;
+    if (tablet_ranges[slot].buttons & 2) input.hi.wParamH |= POINTER_MESSAGE_FLAG_SECONDBUTTON;
+    contact_hwnd = contact ? hwnd : 0;
+
+    data = (UINT64)n[2] * 1024 / 65535;
+    data |= (UINT64)(min( max( (int)value[3], -90 ), 90 ) + 90) << WINE_PEN_TILTX_SHIFT;
+    data |= (UINT64)(min( max( (int)value[4], -90 ), 90 ) + 90) << WINE_PEN_TILTY_SHIFT;
+    if (tablet_ranges[slot].buttons & 2) data |= WINE_PEN_BARREL;
+    if (tablet_ranges[slot].eraser) data |= WINE_PEN_ERASER;
+
+    TRACE( "pen %#x hwnd %p pos %d,%d pressure %u\n", input.hi.uMsg, hwnd, n[0], n[1],
+           (UINT)(data & WINE_PEN_PRESSURE_MASK) );
+    NtUserSendHardwareInput( hwnd, 0, &input, MAKELPARAM( n[0], n[1] ) | (LPARAM)(data << 32) );
+}
+
+/***********************************************************************
+ *              x11drv_xinput2_select_tablet
+ *
+ * For wintab: make sure the raw events of a tablet device reach this process (see
+ * select_tablet_raw_events). Under XWayland the XInput1 device events wintab used to
+ * select almost never arrive.
+ */
+BOOL x11drv_xinput2_select_tablet( Display *display, Window window, int deviceid )
+{
+    int slot;
+
+    if (!xinput2_available) return FALSE;
+    if ((slot = query_tablet_ranges( display, deviceid )) < 0 || !tablet_ranges[slot].is_tablet) return FALSE;
+    if (!tablet_display) select_tablet_raw_events( display );
+    return TRUE;
+}
+
+/***********************************************************************
+ *              X11DRV_TabletRawEvent
+ *
+ * Raw motion or button event of a tablet selected by x11drv_xinput2_select_tablet.
+ */
+static BOOL X11DRV_TabletRawEvent( XGenericEventCookie *xev )
+{
+    struct x11drv_thread_data *data = x11drv_thread_data();
+    XIRawEvent *event = xev->data;
+    double axes[5] = {0};
+    unsigned int i, axes_mask = 0, prev_buttons;
+    const double *value = event->valuators.values;
+    int slot;
+
+    if (!data || event->deviceid == data->xinput2_pointer) return FALSE;
+    if ((slot = query_tablet_ranges( data->display, event->deviceid )) < 0) return FALSE;
+    if (!tablet_ranges[slot].is_tablet) return FALSE;
+
+    /* pass each axis as 0..1 of its XInput2 range, wintab maps it to the range it reports */
+    for (i = 0; i < event->valuators.mask_len * 8; i++)
+    {
+        double min, max;
+
+        if (!XIMaskIsSet( event->valuators.mask, i )) continue;
+        if (i < ARRAY_SIZE(axes))
+        {
+            min = tablet_ranges[slot].min[i];
+            max = tablet_ranges[slot].max[i];
+            tablet_ranges[slot].value[i] = *value;
+            axes[i] = max > min ? (*value - min) / (max - min) : 0.0;
+            axes_mask |= 1 << i;
+        }
+        value++;
+    }
+    /* XI2 button i is wintab button i - 1 */
+    prev_buttons = tablet_ranges[slot].buttons;
+    if (event->detail >= 1 && event->detail <= 32)
+    {
+        if (event->evtype == XI_RawButtonPress) tablet_ranges[slot].buttons |= 1 << (event->detail - 1);
+        if (event->evtype == XI_RawButtonRelease) tablet_ranges[slot].buttons &= ~(1 << (event->detail - 1));
+    }
+
+    x11drv_tablet_event( 0, event->deviceid, tablet_ranges[slot].buttons, event->time, axes, axes_mask );
+    send_pen_pointer( slot, prev_buttons );
+    return TRUE;
+}
