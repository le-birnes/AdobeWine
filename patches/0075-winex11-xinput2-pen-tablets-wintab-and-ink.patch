+/* windows that opened a tablet context, to route XInput2 raw events (which have no window) */
+static HWND attached_owners[16];
+
+static void add_attached_owner( HWND owner )
+{
+    int i, free_slot = -1;
+
+    for (i = 0; i < ARRAY_SIZE(attached_owners); i++)
+    {
+        if (attached_owners[i] == owner) return;
+        if (free_slot < 0 && (!attached_owners[i] || !NtUserIsWindow( attached_owners[i] ))) free_slot = i;
+    }
+    if (free_slot >= 0) attached_owners[free_slot] = owner;
+}
+
+/* the context owner the cursor is over, like the X window of an XInput1 event */
+static HWND owner_from_cursor(void)
+{
+    POINT pt;
+    HWND hwnd = 0;
+    int i;
+
+    if (NtUserGetCursorPos( &pt )) hwnd = NtUserWindowFromPoint( pt.x, pt.y );
+    for (; hwnd; hwnd = NtUserGetAncestor( hwnd, GA_PARENT ))
+        for (i = 0; i < ARRAY_SIZE(attached_owners); i++)
+            if (attached_owners[i] == hwnd) return hwnd;
+    return NtUserGetForegroundWindow();
+}
+
+/* XInput1 axis ranges per cursor, the scale of the packets wintab reports */
+static struct { int min, max; } cursor_axes[CURSORMAX][5];
+
+static void save_cursor_axes( int curnum, XDeviceInfo *device )
+{
+    XAnyClassPtr any = device->inputclassinfo;
+    int i, j;
+
+    for (i = 0; i < device->num_classes; i++)
+    {
+        if (any->class == ValuatorClass)
+        {
+            XValuatorInfoPtr val = (XValuatorInfoPtr)any;
+            for (j = 0; j < val->num_axes && j < ARRAY_SIZE(cursor_axes[curnum]); j++)
+            {
+                cursor_axes[curnum][j].min = val->axes[j].min_value;
+                cursor_axes[curnum][j].max = val->axes[j].max_value;
+            }
+        }
+        any = (XAnyClassPtr)((char *)any + any->length);
+    }
+}
+
+/* XInput2 raw motion or button event of a tablet device (see x11drv_xinput2_select_tablet),
+ * each axis as 0..1 of its range */
+BOOL x11drv_tablet_event( HWND hwnd, int deviceid, unsigned int buttons, Time time,
+                          const double *axes, unsigned int axes_mask )
+{
+    static double last_axes[5];
+    static Time last_time;
+    LPWTI_CURSORS_INFO cursor;
+    int i, curnum;
+
+    if (!hwndTabletDefault || (curnum = cursor_from_device( deviceid, &cursor )) < 0) return FALSE;
+    if (!hwnd) hwnd = owner_from_cursor();
+
+    /* XInput1 proximity events hardly arrive under XWayland: tell the app the pen came in
+     * when its events start again after a pause */
+    if (!last_time || time - last_time > 500)
+    {
+        TRACE( "proximity in\n" );
+        send_message( hwndTabletDefault, WT_PROXIMITY, (WPARAM)hwnd, MAKELPARAM( 1, 1 ) );
+    }
+    last_time = time;
+
+    for (i = 0; i < ARRAY_SIZE(last_axes); i++)
+        if (axes_mask & (1 << i))
+            last_axes[i] = cursor_axes[curnum][i].min + axes[i] * (cursor_axes[curnum][i].max - cursor_axes[curnum][i].min);
+
+    memset( &gMsgPacket, 0, sizeof(WTPACKET) );
+    TRACE( "Received XInput2 tablet event (%p); device id %d, cursor num %d, buttons %#x, pressure %d\n",
+           hwnd, deviceid, curnum, buttons, (int)last_axes[2] );
+
+    /* Set cursor to inverted if cursor is the eraser */
+    gMsgPacket.pkStatus = (cursor->TYPE == CSR_TYPE_ERASER ? TPS_INVERT : 0);
+    gMsgPacket.pkTime = EVENT_x11_time_to_win32_time( time );
+    gMsgPacket.pkSerialNumber = gSerial++;
+    gMsgPacket.pkCursor = curnum;
+    gMsgPacket.pkX = last_axes[0];
+    gMsgPacket.pkY = last_axes[1];
+    gMsgPacket.pkOrientation.orAzimuth = figure_deg( last_axes[3], last_axes[4] );
+    gMsgPacket.pkOrientation.orAltitude = ((1000 - 15 * max( fabs( last_axes[3] ), fabs( last_axes[4] ) ))
+                                           * (gMsgPacket.pkStatus & TPS_INVERT ? -1 : 1));
+    gMsgPacket.pkNormalPressure = last_axes[2];
+    button_state[curnum] = buttons;
+    gMsgPacket.pkButtons = buttons;
+    gMsgPacket.pkChanged = get_changed_state( &gMsgPacket );
+    send_message( hwndTabletDefault, WT_PACKET, gMsgPacket.pkSerialNumber, (LPARAM)hwnd );
+    last_packet = gMsgPacket;
+    return TRUE;
+}
