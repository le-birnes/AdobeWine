+/* WINE_HEAP_QUARANTINE: "1" or "*" for every process, or a ';'-separated list of exe names.
+ * Freed blocks then wait in the delayed free ring (contents left intact, no fill pattern)
+ * before they can be reused, so an application that keeps writing to an object after
+ * freeing it (Creative Cloud desktop's helpers) damages idle memory instead of live free
+ * list links. Windows' heap reuses freed blocks far less eagerly, which hides such bugs. */
+static BOOL heap_quarantine(void)
+{
+    static int enabled = -1;
+
+    if (enabled < 0)
+    {
+        WCHAR buffer[512], *image, *p, *item;
+        UNICODE_STRING name = RTL_CONSTANT_STRING( L"WINE_HEAP_QUARANTINE" ), value;
+        const UNICODE_STRING *path = &NtCurrentTeb()->Peb->ProcessParameters->ImagePathName;
+
+        enabled = 0;
+        value.Buffer = buffer;
+        value.MaximumLength = sizeof(buffer) - sizeof(WCHAR);
+        if (RtlQueryEnvironmentVariable_U( NULL, &name, &value )) return FALSE;
+        buffer[value.Length / sizeof(WCHAR)] = 0;
+        if (!wcscmp( buffer, L"1" ) || !wcscmp( buffer, L"*" )) goto on;
+
+        if (!path->Buffer) return FALSE;
+        image = path->Buffer + path->Length / sizeof(WCHAR);
+        while (image > path->Buffer && image[-1] != '\\' && image[-1] != '/') image--;
+        for (item = buffer; item && *item; item = p)
+        {
+            SIZE_T len;
+            if ((p = wcschr( item, ';' ))) *p++ = 0;
+            len = wcslen( item );
+            if (len && len == path->Buffer + path->Length / sizeof(WCHAR) - image &&
+                !wcsnicmp( image, item, len )) goto on;
+        }
+    }
+    return enabled;
+
+on:
+    /* a longer delay than the free-checking default: busy processes (node.exe) free
+     * thousands of blocks between an object's release and the stale write */
+    max_free_pending = 16384;
+    return (enabled = 1);
+}
