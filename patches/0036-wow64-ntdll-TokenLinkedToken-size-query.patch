--- a/dlls/wow64/security.c
+++ b/dlls/wow64/security.c
@@ -539,6 +539,13 @@ NTSTATUS WINAPI wow64_NtQueryInformationToken( UINT *args )
     {
         TOKEN_LINKED_TOKEN link;
 
+        /* a size query (NULL buffer) must not write the handle; Windows reports
+         * ERROR_BAD_LENGTH, which Adobe Update Service relies on */
+        if (len < sizeof(ULONG))
+        {
+            if (retlen) *retlen = sizeof(ULONG);
+            return STATUS_INFO_LENGTH_MISMATCH;
+        }
         status = NtQueryInformationToken( handle, class, &link, sizeof(link), &ret_size );
         if (!status) *(ULONG *)info = HandleToLong( link.LinkedToken );
         if (retlen) *retlen = sizeof(ULONG);
