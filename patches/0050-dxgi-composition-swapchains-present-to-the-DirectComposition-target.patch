diff --git a/dlls/dxgi/factory.c b/dlls/dxgi/factory.c
index c6bb47f..09f68f5 100644
--- a/dlls/dxgi/factory.c
+++ b/dlls/dxgi/factory.c
@@ -390,10 +390,29 @@ static void STDMETHODCALLTYPE dxgi_factory_UnregisterOcclusionStatus(IWineDXGIFa
 static HRESULT STDMETHODCALLTYPE dxgi_factory_CreateSwapChainForComposition(IWineDXGIFactory *iface,
         IUnknown *device, const DXGI_SWAP_CHAIN_DESC1 *desc, IDXGIOutput *output, IDXGISwapChain1 **swapchain)
 {
-    FIXME("iface %p, device %p, desc %p, output %p, swapchain %p stub!\n",
+    HWND window;
+    HRESULT hr;
+
+    TRACE("iface %p, device %p, desc %p, output %p, swapchain %p.\n",
             iface, device, desc, output, swapchain);
 
-    return E_NOTIMPL;
+    if (!device || !desc || !swapchain)
+        return DXGI_ERROR_INVALID_CALL;
+
+    /* The swapchain renders to a hidden window until DirectComposition attaches it
+     * to a target window; presents then go to that window. */
+    if (!(window = CreateWindowExW(0, L"static", NULL, WS_POPUP, 0, 0, max(desc->Width, 1),
+            max(desc->Height, 1), NULL, NULL, NULL, NULL)))
+        return E_FAIL;
+
+    if (FAILED(hr = IWineDXGIFactory_CreateSwapChainForHwnd(iface, device, window, desc, NULL, output, swapchain)))
+    {
+        DestroyWindow(window);
+        return hr;
+    }
+    if (!d3d11_swapchain_set_composition_window(*swapchain, window))
+        FIXME("Composition is not supported for this swapchain type.\n");
+    return S_OK;
 }
 
