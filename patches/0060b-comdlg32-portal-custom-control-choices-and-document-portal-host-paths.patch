+/* A sandboxed (Flatpak) app gets document portal paths (/run/user/<uid>/doc/<id>/<name>) for the
+ * files it was given. Return the host path recorded by the document portal instead when it is
+ * reachable from here, so the application sees the real directory (After Effects scans the
+ * neighbouring frames of an image sequence itself). */
+static void resolve_document_portal_path(char **path)
+{
+#if defined(__linux__) && defined(HAVE_SYS_XATTR_H)
+    char host[PORTAL_PATH_MAX], *dup;
+    ssize_t len;
+
+    if (!strstr(*path, "/doc/")) return;
+    len = getxattr(*path, "user.document-portal.host-path", host, sizeof(host) - 1);
+    if (len <= 0) return;
+    host[len] = 0;
+    if (host[0] != '/' || access(host, F_OK)) return;
+
+    if (!(dup = strdup(host))) return;
+    TRACE("document portal path %s -> host path %s\n", *path, host);
+    free(*path);
+    *path = dup;
+#endif
+}
