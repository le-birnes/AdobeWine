+/* IFileDialogCustomize check buttons, combo boxes and radio button lists, passed to the
+ * portal as FileChooser "choices"; strings are UTF-8 */
+#define PORTAL_CHOICES_MAX       8
+#define PORTAL_CHOICE_ITEMS_MAX  16
+#define PORTAL_CHOICE_ID_MAX     16
+#define PORTAL_CHOICE_LABEL_MAX  256
+
+struct portal_choice_item
+{
+    char id[PORTAL_CHOICE_ID_MAX];
+    char label[PORTAL_CHOICE_LABEL_MAX];
+};
+
+struct portal_choice
+{
+    char id[PORTAL_CHOICE_ID_MAX];
+    char label[PORTAL_CHOICE_LABEL_MAX];
+    char initial[PORTAL_CHOICE_ID_MAX];  /* item id, or "true"/"false" for a check button */
+    UINT item_count;                     /* 0 for a check button */
+    struct portal_choice_item items[PORTAL_CHOICE_ITEMS_MAX];
+    char selected[PORTAL_CHOICE_ID_MAX]; /* Out: value chosen in the portal, empty if not reported */
+};
+
+struct portal_choices
+{
+    UINT count;
+    struct portal_choice choice[PORTAL_CHOICES_MAX];
+};
