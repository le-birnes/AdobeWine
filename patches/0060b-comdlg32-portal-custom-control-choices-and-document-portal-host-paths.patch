comdlg32: Portal dialogs pass custom controls as choices and return document portal host paths.

Ported from NickPittas' AE4Linux (LGPL-2.1+, permission in AdobeWine issue #2), on top of 0060a
(Wine MR 10060 by Alexander Wilms). AE4Linux describes this After Effects behaviour of its
accepted comdlg32 (docs/fixes-by-layer.md, section 2) but its source is not in the repository,
so this is reconstructed from that description:
- IFileDialogCustomize check buttons, combo boxes and radio button lists (After Effects: "Import
  As", "... Sequence", "Force alphabetical order") are sent as FileChooser "choices"; the values
  the user picks are written back into the controls, with OnCheckButtonToggled/OnItemSelected for
  the ones that changed, before OnFileOk, where After Effects reads them.
- An empty label (a check button without text, a list outside a labelled visual group) gets a
  fallback label ("Option N", "Item N"), as portal backends need one.
- At most 8 controls and 16 items per list are sent; when a list is truncated, the selected item
  is kept in the last slot so the current choice is not lost.
- A document portal path (a sandboxed app such as the Aegnux Flatpak gets
  /run/user/<uid>/doc/<id>/<name>) is replaced by the host path recorded in the
  user.document-portal.host-path xattr when that path is reachable, so the application gets one
  real host path and can scan the neighbouring frames of an image sequence itself (his earlier
  multi-file expansion crashed After Effects and is not used).
Only used when the portal is enabled (0060a); with custom controls only under the FORCE policy.

diff --git a/dlls/comdlg32/itemdlg.c b/dlls/comdlg32/itemdlg.c
index 9bc8ff5..b0da7e2 100644
--- a/dlls/comdlg32/itemdlg.c
+++ b/dlls/comdlg32/itemdlg.c
@@ -2877,10 +2877,183 @@ static enum portal_policy get_portal_policy(void)
     return PORTAL_POLICY_NEVER;
 }
 
+/* Custom controls (After Effects: "Import As" combo box, "Sequence" check buttons) are passed to
+ * the portal as choices, and the values picked there are written back before OnFileOk. */
+static void portal_choice_label(char *dst, const WCHAR *label, const WCHAR *fallback, UINT index)
+{
+    WCHAR buf[64];
+
+    if (!label || !*label)
+    {
+        /* the portal backends need a visible label */
+        swprintf(buf, ARRAY_SIZE(buf), fallback, index);
+        label = buf;
+    }
+    copy_wchar_to_utf8(dst, PORTAL_CHOICE_LABEL_MAX, label);
+}
+
+static WCHAR *portal_get_window_text(HWND hwnd)
+{
+    int len = hwnd ? GetWindowTextLengthW(hwnd) : 0;
+    WCHAR *text = calloc(len + 1, sizeof(WCHAR));
+
+    if (text && len) GetWindowTextW(hwnd, text, len + 1);
+    return text;
+}
+
+static void portal_add_choice(struct portal_choices *choices, customctrl **map,
+                              customctrl *ctrl, customctrl *group)
+{
+    struct portal_choice *c;
+    UINT count = 0, sel = 0, i, n;
+    WCHAR *label;
+
+    if (!(ctrl->cdcstate & CDCS_VISIBLE)) return;
+    if (ctrl->type != IDLG_CCTRL_CHECKBUTTON && ctrl->type != IDLG_CCTRL_COMBOBOX &&
+        ctrl->type != IDLG_CCTRL_RADIOBUTTONLIST) return;
+    if (choices->count >= PORTAL_CHOICES_MAX)
+    {
+        WARN("too many custom controls, control %u keeps its value\n", ctrl->id);
+        return;
+    }
+
+    c = &choices->choice[choices->count];
+    memset(c, 0, sizeof(*c));
+    snprintf(c->id, sizeof(c->id), "%u", ctrl->id);
+
+    /* a check button has its own label, a list takes the label of its visual group */
+    label = portal_get_window_text(ctrl->type == IDLG_CCTRL_CHECKBUTTON ? ctrl->hwnd :
+                                   group ? group->hwnd : NULL);
+    portal_choice_label(c->label, label, L"Option %u", choices->count + 1);
+    free(label);
+
+    if (ctrl->type == IDLG_CCTRL_CHECKBUTTON)
+    {
+        strcpy(c->initial, SendMessageW(ctrl->hwnd, BM_GETCHECK, 0, 0) == BST_CHECKED ? "true" : "false");
+    }
+    else if (ctrl->type == IDLG_CCTRL_COMBOBOX)
+    {
+        LRESULT cur = SendMessageW(ctrl->hwnd, CB_GETCURSEL, 0, 0);
+
+        count = SendMessageW(ctrl->hwnd, CB_GETCOUNT, 0, 0);
+        if (count == CB_ERR || !count) return;
+        sel = (cur == CB_ERR) ? 0 : cur;
+        for (i = 0, n = 0; i < count && n < PORTAL_CHOICE_ITEMS_MAX; i++)
+        {
+            UINT idx = i;
+            LRESULT len;
+            WCHAR *text;
+
+            /* keep the selected item when the list has to be truncated */
+            if (n == PORTAL_CHOICE_ITEMS_MAX - 1 && sel > i) idx = sel;
+            len = SendMessageW(ctrl->hwnd, CB_GETLBTEXTLEN, idx, 0);
+            text = calloc((len == CB_ERR ? 0 : len) + 1, sizeof(WCHAR));
+            if (text && len != CB_ERR) SendMessageW(ctrl->hwnd, CB_GETLBTEXT, idx, (LPARAM)text);
+            snprintf(c->items[n].id, sizeof(c->items[n].id), "%lu",
+                     (DWORD)SendMessageW(ctrl->hwnd, CB_GETITEMDATA, idx, 0));
+            portal_choice_label(c->items[n].label, text, L"Item %u", n + 1);
+            free(text);
+            if (idx == sel) strcpy(c->initial, c->items[n].id);
+            n++;
+        }
+        c->item_count = n;
+        if (!c->initial[0]) strcpy(c->initial, c->items[0].id);
+    }
+    else
+    {
+        cctrl_item *item, *selected = NULL;
+
+        LIST_FOR_EACH_ENTRY(item, &ctrl->sub_items, cctrl_item, entry)
+        {
+            count++;
+            if (SendMessageW(item->hwnd, BM_GETCHECK, 0, 0) == BST_CHECKED) selected = item;
+        }
+        if (!count) return;
+        n = 0;
+        LIST_FOR_EACH_ENTRY(item, &ctrl->sub_items, cctrl_item, entry)
+        {
+            /* keep the selected item when the list has to be truncated */
+            if (n == PORTAL_CHOICE_ITEMS_MAX - 1 && selected && !c->initial[0]) item = selected;
+            snprintf(c->items[n].id, sizeof(c->items[n].id), "%lu", item->id);
+            portal_choice_label(c->items[n].label, item->label, L"Item %u", n + 1);
+            if (item == selected) strcpy(c->initial, c->items[n].id);
+            if (++n == PORTAL_CHOICE_ITEMS_MAX) break;
+        }
+        c->item_count = n;
+        if (!c->initial[0]) strcpy(c->initial, c->items[0].id);
+    }
+
+    map[choices->count++] = ctrl;
+}
+
+static void portal_build_choices(FileDialogImpl *This, struct portal_choices *choices, customctrl **map)
+{
+    customctrl *ctrl, *sub_ctrl;
+
+    choices->count = 0;
+    LIST_FOR_EACH_ENTRY(ctrl, &This->cctrls, customctrl, entry)
+    {
+        if (ctrl->type == IDLG_CCTRL_VISUALGROUP)
+        {
+            if (!(ctrl->cdcstate & CDCS_VISIBLE)) continue;
+            LIST_FOR_EACH_ENTRY(sub_ctrl, &ctrl->sub_cctrls, customctrl, sub_cctrls_entry)
+                portal_add_choice(choices, map, sub_ctrl, ctrl);
+        }
+        else portal_add_choice(choices, map, ctrl, NULL);
+    }
+}
+
+static void portal_apply_choices(FileDialogImpl *This, const struct portal_choices *choices, customctrl **map)
+{
+    UINT i;
+
+    for (i = 0; i < choices->count; i++)
+    {
+        const struct portal_choice *c = &choices->choice[i];
+        customctrl *ctrl = map[i];
+        DWORD item_id;
+
+        if (!c->selected[0]) continue;
+        TRACE("control %u: %s\n", ctrl->id, debugstr_a(c->selected));
+
+        if (ctrl->type == IDLG_CCTRL_CHECKBUTTON)
+        {
+            BOOL checked = !strcmp(c->selected, "true");
+
+            if ((SendMessageW(ctrl->hwnd, BM_GETCHECK, 0, 0) == BST_CHECKED) == checked) continue;
+            SendMessageW(ctrl->hwnd, BM_SETCHECK, checked ? BST_CHECKED : BST_UNCHECKED, 0);
+            cctrl_event_OnCheckButtonToggled(This, ctrl->id, checked);
+        }
+        else if (ctrl->type == IDLG_CCTRL_COMBOBOX)
+        {
+            LRESULT count = SendMessageW(ctrl->hwnd, CB_GETCOUNT, 0, 0), idx;
+
+            item_id = strtoul(c->selected, NULL, 10);
+            for (idx = 0; count != CB_ERR && idx < count; idx++)
+                if (SendMessageW(ctrl->hwnd, CB_GETITEMDATA, idx, 0) == item_id) break;
+            if (count == CB_ERR || idx == count) continue;
+            if (SendMessageW(ctrl->hwnd, CB_GETCURSEL, 0, 0) == idx) continue;
+            SendMessageW(ctrl->hwnd, CB_SETCURSEL, idx, 0);
+            cctrl_event_OnItemSelected(This, ctrl->id, item_id);
+        }
+        else
+        {
+            cctrl_item *item;
+
+            item_id = strtoul(c->selected, NULL, 10);
+            if (!(item = get_item(ctrl, item_id, 0, NULL))) continue;
+            if (SendMessageW(item->hwnd, BM_GETCHECK, 0, 0) == BST_CHECKED) continue;
+            radiobuttonlist_set_selected_item(This, ctrl, item);
+            cctrl_event_OnItemSelected(This, ctrl->id, item_id);
+        }
+    }
+}
