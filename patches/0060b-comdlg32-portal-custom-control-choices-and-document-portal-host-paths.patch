+/* Append "choices" option: a(ssa(ss)s) */
+static void append_choices_option(DBusMessageIter *options_dict, const struct portal_choices *choices)
+{
+    DBusMessageIter entry, variant, array, choice, items, item;
+    const char *key = "choices", *str;
+    UINT i, j;
+
+    if (!choices || !choices->count) return;
+
+    p_dbus_message_iter_open_container(options_dict, DBUS_TYPE_DICT_ENTRY, NULL, &entry);
+    p_dbus_message_iter_append_basic(&entry, DBUS_TYPE_STRING, &key);
+    p_dbus_message_iter_open_container(&entry, DBUS_TYPE_VARIANT, "a(ssa(ss)s)", &variant);
+    p_dbus_message_iter_open_container(&variant, DBUS_TYPE_ARRAY, "(ssa(ss)s)", &array);
+
+    for (i = 0; i < choices->count && i < PORTAL_CHOICES_MAX; i++)
+    {
+        const struct portal_choice *c = &choices->choice[i];
+
+        p_dbus_message_iter_open_container(&array, DBUS_TYPE_STRUCT, NULL, &choice);
+        str = c->id;
+        p_dbus_message_iter_append_basic(&choice, DBUS_TYPE_STRING, &str);
+        str = c->label;
+        p_dbus_message_iter_append_basic(&choice, DBUS_TYPE_STRING, &str);
+        p_dbus_message_iter_open_container(&choice, DBUS_TYPE_ARRAY, "(ss)", &items);
+        for (j = 0; j < c->item_count && j < PORTAL_CHOICE_ITEMS_MAX; j++)
+        {
+            p_dbus_message_iter_open_container(&items, DBUS_TYPE_STRUCT, NULL, &item);
+            str = c->items[j].id;
+            p_dbus_message_iter_append_basic(&item, DBUS_TYPE_STRING, &str);
+            str = c->items[j].label;
+            p_dbus_message_iter_append_basic(&item, DBUS_TYPE_STRING, &str);
+            p_dbus_message_iter_close_container(&items, &item);
+        }
+        p_dbus_message_iter_close_container(&choice, &items);
+        str = c->initial;
+        p_dbus_message_iter_append_basic(&choice, DBUS_TYPE_STRING, &str);
+        p_dbus_message_iter_close_container(&array, &choice);
+    }
+
+    p_dbus_message_iter_close_container(&variant, &array);
+    p_dbus_message_iter_close_container(&entry, &variant);
+    p_dbus_message_iter_close_container(options_dict, &entry);
+}
+
+/* Parse the "choices" result, a(ss) of (choice id, selected value) */
+static void parse_choices_result(struct portal_context *ctx, DBusMessageIter *variant)
+{
+    DBusMessageIter array, pair;
+    const char *id, *value;
+    UINT i;
+
+    if (!ctx->choices || p_dbus_message_iter_get_arg_type(variant) != DBUS_TYPE_ARRAY) return;
+
+    p_dbus_message_iter_recurse(variant, &array);
+    while (p_dbus_message_iter_get_arg_type(&array) == DBUS_TYPE_STRUCT)
+    {
+        p_dbus_message_iter_recurse(&array, &pair);
+        id = value = NULL;
+        if (p_dbus_message_iter_get_arg_type(&pair) == DBUS_TYPE_STRING)
+        {
+            p_dbus_message_iter_get_basic(&pair, &id);
+            if (p_dbus_message_iter_next(&pair) && p_dbus_message_iter_get_arg_type(&pair) == DBUS_TYPE_STRING)
+                p_dbus_message_iter_get_basic(&pair, &value);
+        }
+        if (id && value)
+        {
+            TRACE("choice %s = %s\n", id, value);
+            for (i = 0; i < ctx->choices->count && i < PORTAL_CHOICES_MAX; i++)
+            {
+                struct portal_choice *c = &ctx->choices->choice[i];
+                if (strcmp(c->id, id)) continue;
+                snprintf(c->selected, sizeof(c->selected), "%s", value);
+                break;
+            }
+        }
+        p_dbus_message_iter_next(&array);
+    }
+}
