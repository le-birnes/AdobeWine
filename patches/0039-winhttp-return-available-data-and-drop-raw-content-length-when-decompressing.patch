+/* remove a header line from the stored raw response headers */
+static void remove_raw_header( struct request *request, const WCHAR *field )
+{
+    WCHAR *line, *next;
+    size_t len = wcslen( field );
+
+    if (!request->raw_headers) return;
+    /* the first line is the status line; header lines follow "\r\n" */
+    for (line = wcsstr( request->raw_headers, L"\r\n" ); line; line = next)
+    {
+        line += 2;
+        if (!(next = wcsstr( line, L"\r\n" ))) break;
+        if (!wcsnicmp( line, field, len ) && line[len] == ':')
+        {
+            memmove( line, next + 2, (wcslen( next + 2 ) + 1) * sizeof(WCHAR) );
+            next = line - 2;
+        }
+    }
+}
