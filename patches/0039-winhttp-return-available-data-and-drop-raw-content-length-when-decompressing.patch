winhttp: Return the data that is available from WinHttpReadData and drop the raw Content-Length when decompressing.

With automatic decompression Wine removed Content-Length from its header table but not from
the raw header text (WINHTTP_QUERY_RAW_HEADERS[_CRLF]); cpprestsdk parses the raw text, so
Adobe GrowthSDK sized its buffer from the compressed length and overran the heap with the
decompressed body (Creative Cloud.exe, TESTLOG 2026-10-04). It is now removed from both.
WinHttpReadData waited to fill the caller's buffer; like Windows it now returns what is
available: with data already buffered (after WinHttpQueryDataAvailable) only that, so no more
than was reported, otherwise what one read from the stream gives.
Returning at the end of a chunk must not keep a keep-alive connection from being reused: the
chunked stream now parses framing that is already buffered (the last chunk, line ends) when
asked for end of data, so the request finishes and the connection is pooled. The first version
returned before the last chunk was read and dropped the connection (winhttp:notification
test_persistent_connection: 6 failures, then a hang).
Test: wine/tests/winhttp/readavail.c with wine/tests/winhttp/testserver.py.

diff --git a/dlls/winhttp/request.c b/dlls/winhttp/request.c
index acdd27d..22cefbd 100644
--- a/dlls/winhttp/request.c
+++ b/dlls/winhttp/request.c
@@ -174,10 +174,74 @@ struct chunked_stream
     } state;
 };
 
+static char next_chunked_data_char( struct chunked_stream *stream )
+{
+    assert( stream->buf.size );
+    stream->buf.size--;
+    return stream->buf.buf[stream->buf.pos++];
+}
+
+/* parse one character of chunk framing (size line, line ends, last chunk) */
+static void parse_chunked_framing( struct chunked_stream *chunked_stream, struct request *request )
+{
+    char ch = next_chunked_data_char( chunked_stream );
+
+    switch (chunked_stream->state)
+    {
+    case CHUNKED_STREAM_STATE_READING_CHUNK_SIZE:
+        if (ch >= '0' && ch <= '9') chunked_stream->chunk_size = chunked_stream->chunk_size * 16 + ch - '0';
+        else if (ch >= 'a' && ch <= 'f') chunked_stream->chunk_size = chunked_stream->chunk_size * 16 + ch - 'a' + 10;
+        else if (ch >= 'A' && ch <= 'F') chunked_stream->chunk_size = chunked_stream->chunk_size * 16 + ch - 'A' + 10;
+        else if (ch == ';' || ch == '\r' || ch == '\n')
+        {
+            TRACE( "reading %lu byte chunk\n", chunked_stream->chunk_size );
+            chunked_stream->buf.size++;
+            chunked_stream->buf.pos--;
+            if (request->content_length == ~0) request->content_length = chunked_stream->chunk_size;
+            else request->content_length += chunked_stream->chunk_size;
+            chunked_stream->state = CHUNKED_STREAM_STATE_DISCARD_EOL_AFTER_SIZE;
+        }
+        break;
+
+    case CHUNKED_STREAM_STATE_DISCARD_EOL_AFTER_SIZE:
+        if (ch == '\n')
+        {
+            if (chunked_stream->chunk_size)
+                chunked_stream->state = CHUNKED_STREAM_STATE_READING_CHUNK;
+            else
+                chunked_stream->state = CHUNKED_STREAM_STATE_DISCARD_EOL_AT_END;
+        }
+        else if (ch != '\r') WARN( "unexpected char '%c'\n", ch );
+        break;
+
+    case CHUNKED_STREAM_STATE_DISCARD_EOL_AFTER_DATA:
+        if (ch == '\n') chunked_stream->state = CHUNKED_STREAM_STATE_READING_CHUNK_SIZE;
+        else if (ch != '\r') WARN( "unexpected char '%c'\n", ch );
+        break;
+
+    case CHUNKED_STREAM_STATE_DISCARD_EOL_AT_END:
+        if (ch == '\n') chunked_stream->state = CHUNKED_STREAM_STATE_END_OF_STREAM;
+        else if (ch != '\r') WARN( "unexpected char '%c'\n", ch );
+        break;
+
+    default:
+        assert( 0 );
+    }
+}
+
 static BOOL chunked_end_of_data( struct data_stream *stream, struct request *request )
 {
     struct chunked_stream *chunked_stream = (struct chunked_stream *)stream;
 
+    /* Parse framing that has already been received, without waiting for more: after a read
+     * that stops at the end of a chunk (read_data returns what is available), the last chunk
+     * is often already buffered, and seeing it here lets the connection be reused. */
+    while (chunked_stream->buf.size && (chunked_stream->state == CHUNKED_STREAM_STATE_READING_CHUNK_SIZE ||
+           chunked_stream->state == CHUNKED_STREAM_STATE_DISCARD_EOL_AFTER_SIZE ||
+           chunked_stream->state == CHUNKED_STREAM_STATE_DISCARD_EOL_AFTER_DATA ||
+           chunked_stream->state == CHUNKED_STREAM_STATE_DISCARD_EOL_AT_END))
+        parse_chunked_framing( chunked_stream, request );
+
     switch (chunked_stream->state)
     {
     case CHUNKED_STREAM_STATE_DISCARD_EOL_AT_END:
@@ -189,20 +253,12 @@ static BOOL chunked_end_of_data( struct data_stream *stream, struct request *req
     }
 }
 
