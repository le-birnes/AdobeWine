From: AdobeWine
Subject: [PATCH] msi: PatchFiles leaves a file that is already at the version the patch makes.

InstallFiles keeps a file on disk that is newer than the package's (file versioning rules), but PatchFiles then
applied the package's delta to it anyway. The delta was made against the package's own older copy, so the CRC of
the file on disk does not match and the patch fails with ERROR_PATCH_WRONG_FILE; the patch is vital, so the
whole install rolls back. Acrobat's MSI patches syswow64\msvcp140.dll (14.14) while the prefix has VC++ 14.51, and
every Acrobat install failed at PatchFiles. A patch is now skipped when the file on disk is already at or above
the version the patched File table gives; a File Version that is not a version (a companion file key) is not
compared.
Test: Acrobat_DC_Web_x64_WWMUI setup.exe /sAll /rs /msi EULA_ACCEPT=YES in a copy of the main prefix: failed
with "Failed to apply patch to file: L"msvcp140.dll..."" and 1603 before; after, trace shows "not patching" for
the VC++ files and Acrobat installs (Acrobat.exe, 1.3 GB).
---
diff --git a/dlls/msi/files.c b/dlls/msi/files.c
index aedb893..fee9070 100644
--- a/dlls/msi/files.c
+++ b/dlls/msi/files.c
@@ -789,6 +789,25 @@ UINT msi_patch_assembly( MSIPACKAGE *package, MSIASSEMBLY *assembly, MSIFILEPATC
     return r;
 }
 
+/* The patched File table gives the version the patch makes. A file on disk already at that version or newer
+ * (InstallFiles kept it, e.g. a shared VC++ runtime newer than the package's) is not the patch's source; Windows
+ * leaves it as it is. */
+static BOOL patch_target_is_current( MSIPACKAGE *package, MSIFILE *file )
+{
+    VS_FIXEDFILEINFO *disk;
+    BOOL ret;
+
+    /* a Version that is not a version names a companion file */
+    if (file->state == msifs_installed || !file->Version || !iswdigit( file->Version[0] ) ||
+        !(disk = msi_get_disk_file_version( package, file->TargetPath ))) return FALSE;
+    ret = msi_compare_file_versions( disk, file->Version ) >= 0;
+    if (ret) TRACE("not patching %s: %u.%u.%u.%u on disk, patch makes %s\n", debugstr_w(file->File),
+                   HIWORD(disk->dwFileVersionMS), LOWORD(disk->dwFileVersionMS), HIWORD(disk->dwFileVersionLS),
+                   LOWORD(disk->dwFileVersionLS), debugstr_w(file->Version));
+    free( disk );
+    return ret;
+}
+
 UINT ACTION_PatchFiles( MSIPACKAGE *package )
 {
     MSIFILEPATCH *patch;
@@ -818,6 +837,7 @@ UINT ACTION_PatchFiles( MSIPACKAGE *package )
         }
         comp->Action = msi_get_component_action( package, comp );
         if (!comp->Enabled || comp->Action != INSTALLSTATE_LOCAL) continue;
+        if ((patch->skip = patch_target_is_current( package, file ))) continue;
 
         if (!patch->extracted)
         {
@@ -850,7 +870,7 @@ UINT ACTION_PatchFiles( MSIPACKAGE *package )
     {
         MSICOMPONENT *comp = patch->File->Component;
 
-        if (msi_is_global_assembly( comp ) || !patch->path) continue;
+        if (msi_is_global_assembly( comp ) || !patch->path || patch->skip) continue;
 
         rc = patch_file( package, patch );
         if (rc && !(patch->Attributes & msidbPatchAttributesNonVital))
diff --git a/dlls/msi/msipriv.h b/dlls/msi/msipriv.h
index 99ad03b..7783ef2 100644
--- a/dlls/msi/msipriv.h
+++ b/dlls/msi/msipriv.h
@@ -635,6 +635,7 @@ typedef struct tagMSIFILEPATCH
     INT PatchSize;
     INT Attributes;
     BOOL extracted;
+    BOOL skip;  /* the file on disk is already at the version the patch makes */
     UINT disk_id;
     WCHAR *path;
 } MSIFILEPATCH;
