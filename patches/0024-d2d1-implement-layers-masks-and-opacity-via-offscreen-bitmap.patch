+static inline D2D1_MATRIX_3X2_F identity_3x2(void)
+{
+    D2D1_MATRIX_3X2_F m;
+
+    m._11 = 1.0f; m._12 = 0.0f;
+    m._21 = 0.0f; m._22 = 1.0f;
+    m._31 = 0.0f; m._32 = 0.0f;
+    return m;
+}
+
+/* Start rendering into an offscreen bitmap for a layer with a mask or opacity. */
+static void d2d_device_context_begin_layer(struct d2d_device_context *context, ID2D1Geometry *mask,
+        const D2D1_MATRIX_3X2_F *mask_transform, float opacity)
+{
+    ID2D1DeviceContext6 *iface = &context->ID2D1DeviceContext6_iface;
+    D2D1_BITMAP_PROPERTIES1 props = {{0}};
+    struct d2d_layer_state *layer;
+    ID2D1Bitmap1 *bitmap;
+    unsigned int i;
+
+    if (!d2d_array_reserve((void **)&context->layers, &context->layers_size,
+            context->layer_count + 1, sizeof(*context->layers)))
+        return;
+    layer = &context->layers[context->layer_count++];
+    memset(layer, 0, sizeof(*layer));
+
+    if ((!mask && opacity >= 1.0f) || context->target.type != D2D_TARGET_BITMAP)
+        return;
+
+    bitmap = NULL;
+    for (i = 0; i < ARRAY_SIZE(context->layer_cache); ++i)
+    {
+        struct d2d_bitmap *b;
+
+        if (!context->layer_cache[i])
+            continue;
+        b = unsafe_impl_from_ID2D1Bitmap((ID2D1Bitmap *)context->layer_cache[i]);
+        if (b->pixel_size.width == context->pixel_size.width && b->pixel_size.height == context->pixel_size.height
+                && b->format.format == context->desc.pixelFormat.format)
+        {
+            static const float transparent[4];
+            ID3D11DeviceContext *d3d_context;
+
+            bitmap = context->layer_cache[i];
+            context->layer_cache[i] = NULL;
+            ID3D11Device1_GetImmediateContext(context->d3d_device, &d3d_context);
+            ID3D11DeviceContext_ClearRenderTargetView(d3d_context, b->rtv, transparent);
+            ID3D11DeviceContext_Release(d3d_context);
+            break;
+        }
+    }
+    if (!bitmap)
+    {
+        props.pixelFormat = context->desc.pixelFormat;
+        props.dpiX = props.dpiY = 96.0f;
+        props.bitmapOptions = D2D1_BITMAP_OPTIONS_TARGET;
+        if (FAILED(d2d_device_context_ID2D1DeviceContext_CreateBitmap(iface, context->pixel_size, NULL, 0, &props, &bitmap)))
+        {
+            WARN("Failed to create layer bitmap.\n");
+            return;
+        }
+    }
+
+    d2d_device_context_GetTarget(iface, &layer->target);
+    d2d_device_context_SetTarget(iface, (ID2D1Image *)bitmap);
+    layer->bitmap = bitmap;
+    if ((layer->mask = mask))
+        ID2D1Geometry_AddRef(mask);
+    layer->mask_transform = mask_transform ? *mask_transform : identity_3x2();
+    d2d_matrix_multiply(&layer->mask_transform, &context->drawing_state.transform);
+    layer->opacity = opacity;
+    TRACE("Redirected layer %Iu to bitmap %p, mask %p, opacity %.8e.\n", context->layer_count - 1,
+            bitmap, mask, opacity);
+}
+
+/* Composite a redirected layer onto the restored target through its mask. */
+static void d2d_device_context_end_layer(struct d2d_device_context *context)
+{
+    ID2D1DeviceContext6 *iface = &context->ID2D1DeviceContext6_iface;
+    D2D1_BITMAP_BRUSH_PROPERTIES bitmap_brush_desc;
+    D2D1_MATRIX_3X2_F world, w, b;
+    D2D1_BRUSH_PROPERTIES brush_desc;
+    ID2D1BitmapBrush *brush;
+    struct d2d_layer_state layer;
+    unsigned int i;
+
+    if (!context->layer_count)
+        return;
+    layer = context->layers[--context->layer_count];
+    if (!layer.bitmap)
+        return;
+
+    d2d_device_context_SetTarget(iface, layer.target);
+    if (layer.target)
+        ID2D1Image_Release(layer.target);
+
+    world = context->drawing_state.transform;
+    w = layer.mask ? layer.mask_transform : identity_3x2();
+    /* Brush space must map onto device pixels: undo the transform and the DPI scale. */
+    b = w;
+    b._11 *= context->desc.dpiX / 96.0f; b._21 *= context->desc.dpiX / 96.0f; b._31 *= context->desc.dpiX / 96.0f;
+    b._12 *= context->desc.dpiY / 96.0f; b._22 *= context->desc.dpiY / 96.0f; b._32 *= context->desc.dpiY / 96.0f;
+    if (!d2d_matrix_invert(&brush_desc.transform, &b))
+        brush_desc.transform = identity_3x2();
+    brush_desc.opacity = layer.opacity;
+    bitmap_brush_desc.extendModeX = D2D1_EXTEND_MODE_CLAMP;
+    bitmap_brush_desc.extendModeY = D2D1_EXTEND_MODE_CLAMP;
+    bitmap_brush_desc.interpolationMode = D2D1_BITMAP_INTERPOLATION_MODE_NEAREST_NEIGHBOR;
+
+    if (SUCCEEDED(d2d_device_context_CreateBitmapBrush(iface, (ID2D1Bitmap *)layer.bitmap,
+            &bitmap_brush_desc, &brush_desc, &brush)))
+    {
+        context->drawing_state.transform = w;
+        if (layer.mask)
+        {
+            ID2D1DeviceContext6_FillGeometry(iface, layer.mask, (ID2D1Brush *)brush, NULL);
+        }
+        else
+        {
+            D2D1_RECT_F rect = {0.0f, 0.0f, context->pixel_size.width * 96.0f / context->desc.dpiX,
+                    context->pixel_size.height * 96.0f / context->desc.dpiY};
+            ID2D1DeviceContext6_FillRectangle(iface, &rect, (ID2D1Brush *)brush);
+        }
+        context->drawing_state.transform = world;
+        ID2D1BitmapBrush_Release(brush);
+    }
+
+    if (layer.mask)
+        ID2D1Geometry_Release(layer.mask);
+    for (i = 0; i < ARRAY_SIZE(context->layer_cache); ++i)
+    {
+        if (!context->layer_cache[i])
+        {
+            context->layer_cache[i] = layer.bitmap;
+            layer.bitmap = NULL;
+            break;
+        }
+    }
+    if (layer.bitmap)
+        ID2D1Bitmap1_Release(layer.bitmap);
+}
+
+/* Layers are approximated by their clip: the content bounds, intersected with the bounds of
+ * the geometric mask. Opacity and the exact mask shape are not applied yet. Apps such as
+ * Adobe Audition push a layer to restrict a repaint to the invalid region; without the clip
+ * the background fill of that repaint wipes everything else. */
+static void d2d_device_context_push_layer_clip(struct d2d_device_context *context,
+        const D2D1_RECT_F *content_bounds, ID2D1Geometry *mask, const D2D1_MATRIX_3X2_F *mask_transform)
+{
+    const D2D1_MATRIX_3X2_F *t = &context->drawing_state.transform;
+    float x_scale = context->desc.dpiX / 96.0f, y_scale = context->desc.dpiY / 96.0f;
+    D2D1_RECT_F clip = {-FLT_MAX, -FLT_MAX, FLT_MAX, FLT_MAX};
+    D2D1_POINT_2F p;
+
+    if (content_bounds && content_bounds->left > -FLT_MAX && content_bounds->top > -FLT_MAX
+            && content_bounds->right < FLT_MAX && content_bounds->bottom < FLT_MAX)
+    {
+        d2d_point_transform(&p, t, content_bounds->left * x_scale, content_bounds->top * y_scale);
+        d2d_rect_set(&clip, p.x, p.y, p.x, p.y);
+        d2d_point_transform(&p, t, content_bounds->left * x_scale, content_bounds->bottom * y_scale);
+        d2d_rect_expand(&clip, &p);
+        d2d_point_transform(&p, t, content_bounds->right * x_scale, content_bounds->top * y_scale);
+        d2d_rect_expand(&clip, &p);
+        d2d_point_transform(&p, t, content_bounds->right * x_scale, content_bounds->bottom * y_scale);
+        d2d_rect_expand(&clip, &p);
+    }
+
+    if (mask)
+    {
+        D2D1_MATRIX_3X2_F m = mask_transform ? *mask_transform : identity_3x2(), w;
+        D2D1_RECT_F bounds;
+
+        w = *t;
+        w._11 *= x_scale; w._12 *= x_scale; w._21 *= y_scale; w._22 *= y_scale;
+        d2d_matrix_multiply(&m, &w);
+        if (SUCCEEDED(ID2D1Geometry_GetBounds(mask, &m, &bounds)) && bounds.left <= bounds.right)
+        {
+            TRACE("mask bounds %s.\n", debug_d2d_rect_f(&bounds));
+            d2d_rect_intersect(&clip, &bounds);
+        }
+    }
+
+    TRACE("layer clip %s.\n", debug_d2d_rect_f(&clip));
+    if (!d2d_clip_stack_push(&context->clip_stack, &clip))
+        WARN("Failed to push layer clip.\n");
+}
