+static HRESULT WINAPI deployment_operation_GetRuntimeClassName( IAsyncOperationWithProgress_DeploymentResult_DeploymentProgress *iface, HSTRING *class_name )
+{
+    static const WCHAR name[] = L"Windows.Foundation.IAsyncOperationWithProgress`2<Windows.Management.Deployment.DeploymentResult,Windows.Management.Deployment.DeploymentProgress>";
+    return WindowsCreateString( name, wcslen( name ), class_name );
+}
+
+static HRESULT WINAPI deployment_operation_GetTrustLevel( IAsyncOperationWithProgress_DeploymentResult_DeploymentProgress *iface, TrustLevel *trust_level )
+{
+    *trust_level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI deployment_operation_put_Progress( IAsyncOperationWithProgress_DeploymentResult_DeploymentProgress *iface,
+                                                         IAsyncOperationProgressHandler_DeploymentResult_DeploymentProgress *handler )
+{
+    struct deployment_operation *impl = impl_from_deployment_operation( iface );
+
+    TRACE( "iface %p, handler %p.\n", iface, handler );
+
+    if (impl->progress) IAsyncOperationProgressHandler_DeploymentResult_DeploymentProgress_Release( impl->progress );
+    if ((impl->progress = handler)) IAsyncOperationProgressHandler_DeploymentResult_DeploymentProgress_AddRef( handler );
+    return S_OK;
+}
+
+static HRESULT WINAPI deployment_operation_get_Progress( IAsyncOperationWithProgress_DeploymentResult_DeploymentProgress *iface,
+                                                         IAsyncOperationProgressHandler_DeploymentResult_DeploymentProgress **handler )
+{
+    struct deployment_operation *impl = impl_from_deployment_operation( iface );
+
+    TRACE( "iface %p, handler %p.\n", iface, handler );
+
+    if ((*handler = impl->progress)) IAsyncOperationProgressHandler_DeploymentResult_DeploymentProgress_AddRef( *handler );
+    return S_OK;
+}
+
+static HRESULT WINAPI deployment_operation_put_Completed( IAsyncOperationWithProgress_DeploymentResult_DeploymentProgress *iface,
+                                                          IAsyncOperationWithProgressCompletedHandler_DeploymentResult_DeploymentProgress *handler )
+{
+    struct deployment_operation *impl = impl_from_deployment_operation( iface );
+
+    TRACE( "iface %p, handler %p.\n", iface, handler );
+
+    if (!handler) return E_POINTER;
+    if (impl->completed) return E_ILLEGAL_DELEGATE_ASSIGNMENT;
+
+    impl->completed = handler;
+    IAsyncOperationWithProgressCompletedHandler_DeploymentResult_DeploymentProgress_AddRef( handler );
+
+    /* The operation is already complete, notify right away. */
+    IAsyncOperationWithProgressCompletedHandler_DeploymentResult_DeploymentProgress_Invoke( handler, iface, Completed );
+    return S_OK;
+}
+
+static HRESULT WINAPI deployment_operation_get_Completed( IAsyncOperationWithProgress_DeploymentResult_DeploymentProgress *iface,
+                                                          IAsyncOperationWithProgressCompletedHandler_DeploymentResult_DeploymentProgress **handler )
+{
+    struct deployment_operation *impl = impl_from_deployment_operation( iface );
+
+    TRACE( "iface %p, handler %p.\n", iface, handler );
+
+    if ((*handler = impl->completed)) IAsyncOperationWithProgressCompletedHandler_DeploymentResult_DeploymentProgress_AddRef( *handler );
+    return S_OK;
+}
+
+static HRESULT WINAPI deployment_operation_GetResults( IAsyncOperationWithProgress_DeploymentResult_DeploymentProgress *iface, IDeploymentResult **results )
+{
+    struct deployment_operation *impl = impl_from_deployment_operation( iface );
+
+    TRACE( "iface %p, results %p.\n", iface, results );
+
+    *results = impl->result;
+    IDeploymentResult_AddRef( *results );
+    return S_OK;
+}
