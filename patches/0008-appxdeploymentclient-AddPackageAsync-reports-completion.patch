+static HRESULT create_completed_deployment_operation( IAsyncOperationWithProgress_DeploymentResult_DeploymentProgress **out )
+{
+    struct deployment_operation *impl;
+    struct deployment_result *result;
+
+    *out = NULL;
+    if (!(result = calloc( 1, sizeof(*result) ))) return E_OUTOFMEMORY;
+    if (!(impl = calloc( 1, sizeof(*impl) )))
+    {
+        free( result );
+        return E_OUTOFMEMORY;
+    }
+
+    result->IDeploymentResult_iface.lpVtbl = &deployment_result_vtbl;
+    result->ref = 1;
+
+    impl->IAsyncOperationWithProgress_DeploymentResult_DeploymentProgress_iface.lpVtbl = &deployment_operation_vtbl;
+    impl->IAsyncInfo_iface.lpVtbl = &deployment_async_info_vtbl;
+    impl->ref = 1;
+    impl->result = &result->IDeploymentResult_iface;
+
+    *out = &impl->IAsyncOperationWithProgress_DeploymentResult_DeploymentProgress_iface;
+    return S_OK;
+}
