 NTSTATUS WINAPI NtGdiDdDDIOpenAdapterFromHdc( D3DKMT_OPENADAPTERFROMHDC *desc )
 {
-    FIXME( "(%p): stub\n", desc );
-    return STATUS_NO_MEMORY;
+    D3DKMT_OPENADAPTERFROMGDIDISPLAYNAME name_desc = {{0}};
+    DISPLAY_DEVICEW device = {.cb = sizeof(device)};
+    NTSTATUS status;
+    DWORD i;
+    DC *dc;
+
+    TRACE( "(%p)\n", desc );
+
+    if (!desc) return STATUS_INVALID_PARAMETER;
+    if (!(dc = get_dc_ptr( desc->hDc ))) return STATUS_INVALID_PARAMETER;
+    lstrcpynW( name_desc.DeviceName, dc->display, ARRAY_SIZE(name_desc.DeviceName) );
+    release_dc_ptr( dc );
+
+    /* a DC that is not for a specific display (GetDC) uses the primary one */
+    for (i = 0; !name_desc.DeviceName[0] && !NtUserEnumDisplayDevices( NULL, i, &device, 0 ); i++)
+        if (device.StateFlags & DISPLAY_DEVICE_PRIMARY_DEVICE)
+            lstrcpynW( name_desc.DeviceName, device.DeviceName, ARRAY_SIZE(name_desc.DeviceName) );
+
+    if ((status = NtUserCallOneParam( (ULONG_PTR)&name_desc, NtUserCallOneParam_D3DKMTOpenAdapterFromGdiDisplayName )))
+        return status;
+    desc->hAdapter = name_desc.hAdapter;
+    desc->AdapterLuid = name_desc.AdapterLuid;
+    desc->VidPnSourceId = name_desc.VidPnSourceId;
+    return STATUS_SUCCESS;
 }
 
