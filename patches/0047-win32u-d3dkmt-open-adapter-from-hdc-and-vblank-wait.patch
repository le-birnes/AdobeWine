+/******************************************************************************
+ *           NtGdiDdDDIWaitForVerticalBlankEvent    (win32u.@)
+ *
+ * Waits until the next vertical blank of the current display mode, computed from the
+ * performance counter as DwmFlush does (there is no real vblank to wait for here).
+ * Chromium's GPU vsync thread paces its frames with this.
+ */
+NTSTATUS WINAPI NtGdiDdDDIWaitForVerticalBlankEvent( const D3DKMT_WAITFORVERTICALBLANKEVENT *desc )
+{
+    DEVMODEW mode = {.dmSize = sizeof(mode)};
+    LARGE_INTEGER qpc, qpf, delay;
+    LONGLONG period;
+    DWORD frequency = 60;
+
+    TRACE( "(%p)\n", desc );
+
+    if (!desc || !desc->hAdapter) return STATUS_INVALID_PARAMETER;
+
+    if (NtUserEnumDisplaySettings( NULL, ENUM_CURRENT_SETTINGS, &mode, 0 ) && mode.dmDisplayFrequency > 1)
+        frequency = mode.dmDisplayFrequency;
+    NtQueryPerformanceCounter( &qpc, &qpf );
+    period = qpf.QuadPart / frequency;
+    delay.QuadPart = -((period - qpc.QuadPart % period) * 10000000 / qpf.QuadPart);
+    NtDelayExecution( FALSE, &delay );
+    return STATUS_SUCCESS;
+}
+
 /******************************************************************************
  *           NtGdiDdDDICheckVidPnExclusiveOwnership    (win32u.@)
  */
