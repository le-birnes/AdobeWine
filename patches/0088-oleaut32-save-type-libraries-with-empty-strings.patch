oleaut32: Save type libraries with empty strings (empty doc strings).

ICreateTypeLib2::SaveAllChanges failed with E_UNEXPECTED, and wrote nothing, as soon as the library held an empty
string: WMSFT_compile_strings took WideCharToMultiByte's 0 for a zero-length string as an error. InDesign's
"Support for Visual Basic" plug-in builds its scripting type library (Resources for Visual Basic.tlb, 3.2 MB) with
CreateTypeLib2 and sets hundreds of empty function doc strings, so the file was never written: InDesign's COM object
then answered GetIDsOfNames("DoScript") with DISP_E_UNKNOWNNAME and could not be scripted from other programs.
An empty string is now stored with length 0, like any other. Test: tests/typelib/emptydoc.c (save, load back,
read the empty doc string).

--- a/dlls/oleaut32/typelib.c
+++ b/dlls/oleaut32/typelib.c
@@ -9172,7 +9172,7 @@ static HRESULT WMSFT_compile_strings(ITypeLibImpl *This,
         int size;
 
         size = WideCharToMultiByte(CP_ACP, 0, str->str, lstrlenW(str->str), NULL, 0, NULL, NULL);
-        if (size == 0)
+        if (size == 0 && *str->str)     /* an empty string (an empty doc string) is stored with length 0 */
             return E_UNEXPECTED;
 
         size += sizeof(INT16);
@@ -9196,7 +9196,7 @@ static HRESULT WMSFT_compile_strings(ITypeLibImpl *This,
 
         size = WideCharToMultiByte(CP_ACP, 0, str->str, lstrlenW(str->str),
                 data + sizeof(INT16), file->string_seg.len - last_offs - sizeof(INT16), NULL, NULL);
-        if (size == 0) {
+        if (size == 0 && *str->str) {
             free(file->string_seg.data);
             file->string_seg.data = NULL;
             return E_UNEXPECTED;
