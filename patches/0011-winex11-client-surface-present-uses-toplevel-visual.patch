diff --git a/dlls/winex11.drv/init.c b/dlls/winex11.drv/init.c
index cf032cb..8ddc262 100644
--- a/dlls/winex11.drv/init.c
+++ b/dlls/winex11.drv/init.c
@@ -398,7 +398,26 @@ static void X11DRV_client_surface_present( struct client_surface *client, HDC hd
            toplevel, wine_dbgstr_rect(&rect_dst), region );
 
     if (get_dc_drawable( surface->hdc_dst, &rect ) != window || !EqualRect( &rect, &rect_dst ))
-        set_dc_drawable( surface->hdc_dst, window, &rect_dst, IncludeInferiors );
+    {
+        /* The toplevel may use a different visual than the client surface (e.g. an ARGB
+         * visual for layered windows). Tell the DC about it so that the blit converts
+         * between formats instead of issuing a mismatched XCopyArea. */
+        struct x11drv_escape_set_drawable escape =
+        {
+            .code = X11DRV_SET_DRAWABLE,
+            .drawable = window,
+            .dc_rect = rect_dst,
+            .mode = IncludeInferiors,
+        };
+        struct x11drv_win_data *data;
+
+        if ((data = get_win_data( toplevel )))
+        {
+            if (data->vis.visualid != default_visual.visualid) escape.visual = data->vis;
+            release_win_data( data );
+        }
+        NtGdiExtEscape( surface->hdc_dst, NULL, 0, X11DRV_ESCAPE, sizeof(escape), (LPSTR)&escape, 0, NULL );
+    }
     if (region) NtGdiExtSelectClipRgn( surface->hdc_dst, region, RGN_COPY );
 
     NtGdiStretchBlt( surface->hdc_dst, 0, 0, rect_dst.right - rect_dst.left, rect_dst.bottom - rect_dst.top,
