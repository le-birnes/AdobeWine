+    ID3D11Texture2D_GetDesc(texture, &interop->desc);
+    if (!d3d11_format_to_cuda(interop->desc.Format, &interop->format, &interop->channels, &interop->bpp)
+            || interop->desc.SampleDesc.Count > 1)
