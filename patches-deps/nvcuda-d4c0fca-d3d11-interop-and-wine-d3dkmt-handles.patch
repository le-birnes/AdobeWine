+/* Wine's D3DKMT shared resources (upstream Wine 11): the host fd behind an NT or global handle */
+#define D3DKMT_ESCAPE_GET_RESOURCE_FD_WINE_ 0x80000002
+struct d3dkmt_get_resource_fd_wine
+{
+    HANDLE shared;
+    D3DKMT_HANDLE global;
+    int fd;
+};
+
+#define D3DKMT_ESCAPE_GET_SYNC_FD_WINE_ 0x80000003
+
+static int get_d3dkmt_fd(UINT type, HANDLE shared, D3DKMT_HANDLE global)
+{
+    struct d3dkmt_get_resource_fd_wine params = {shared, global, -1};
+    D3DKMT_ESCAPE escape = {0};
+
+    escape.Type = type;
