+/*
+ * D3D11 interop through host memory.
+ *
+ * The native driver cannot see a D3D11 resource under Wine (it is a Vulkan image in DXVK), so a registered
+ * 2D texture gets a CUDA array of the same size and format: mapping copies the texture into the array
+ * (through a staging texture), unmapping copies the array back into the texture. That is a round trip
+ * through system memory per map, slower than real interop but enough for display paths such as
+ * After Effects' composition viewer, which stayed black while registration failed.
+ */
+
+#ifndef CUDA_ERROR_ALREADY_MAPPED
+#define CUDA_ERROR_ALREADY_MAPPED 208
+#endif
+#ifndef CUDA_ERROR_NOT_MAPPED
+#define CUDA_ERROR_NOT_MAPPED 211
+#endif
+#define CU_MEMORYTYPE_HOST_ 0x1
+#define CU_MEMORYTYPE_ARRAY_ 0x3
+#define CU_AD_FORMAT_UNSIGNED_INT8_ 0x01
+#define CU_AD_FORMAT_UNSIGNED_INT16_ 0x02
+#define CU_AD_FORMAT_UNSIGNED_INT32_ 0x03
+#define CU_AD_FORMAT_HALF_ 0x10
+#define CU_AD_FORMAT_FLOAT_ 0x20
+#define CUDA_ARRAY3D_SURFACE_LDST_ 0x02
+#define CUDA_ARRAY3D_TEXTURE_GATHER_ 0x08
+#define CU_GRAPHICS_REGISTER_FLAGS_READ_ONLY_ 0x01
+#define CU_GRAPHICS_REGISTER_FLAGS_WRITE_DISCARD_ 0x02
+#define CU_GRAPHICS_REGISTER_FLAGS_SURFACE_LDST_ 0x04
+#define CU_GRAPHICS_REGISTER_FLAGS_TEXTURE_GATHER_ 0x08
+#define CU_GRAPHICS_MAP_RESOURCE_FLAGS_READ_ONLY_ 0x01
+#define CU_GRAPHICS_MAP_RESOURCE_FLAGS_WRITE_DISCARD_ 0x02
+
+struct d3d11_interop
+{
+    struct list entry;
+    ID3D11Texture2D *texture;
+    ID3D11Texture2D *staging;
+    ID3D11Device *device;
+    D3D11_TEXTURE2D_DESC desc;
+    CUarray_format format;
+    unsigned int channels;
+    unsigned int bpp;
+    unsigned int register_flags;
+    unsigned int map_flags;
+    CUarray array;
+    BOOL mapped;
+    BYTE *buffer;
+};
+
+static struct list d3d11_interops = LIST_INIT( d3d11_interops );
+static CRITICAL_SECTION d3d11_interop_cs;
+static CRITICAL_SECTION_DEBUG d3d11_interop_cs_debug =
+{
+    0, 0, &d3d11_interop_cs,
+    { &d3d11_interop_cs_debug.ProcessLocksList, &d3d11_interop_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": d3d11_interop_cs") }
+};
+static CRITICAL_SECTION d3d11_interop_cs = { &d3d11_interop_cs_debug, -1, 0, 0, 0, 0 };
+
+static BOOL d3d11_format_to_cuda(DXGI_FORMAT format, CUarray_format *cu_format, unsigned int *channels, unsigned int *bpp)
+{
+    switch (format)
+    {
+    case DXGI_FORMAT_R8G8B8A8_TYPELESS: case DXGI_FORMAT_R8G8B8A8_UNORM: case DXGI_FORMAT_R8G8B8A8_UNORM_SRGB:
+    case DXGI_FORMAT_R8G8B8A8_UINT: case DXGI_FORMAT_B8G8R8A8_TYPELESS: case DXGI_FORMAT_B8G8R8A8_UNORM:
+    case DXGI_FORMAT_B8G8R8A8_UNORM_SRGB: case DXGI_FORMAT_B8G8R8X8_UNORM: case DXGI_FORMAT_B8G8R8X8_UNORM_SRGB:
+        *cu_format = CU_AD_FORMAT_UNSIGNED_INT8_; *channels = 4; *bpp = 4; return TRUE;
+    case DXGI_FORMAT_R16G16B16A16_TYPELESS: case DXGI_FORMAT_R16G16B16A16_UNORM: case DXGI_FORMAT_R16G16B16A16_UINT:
+        *cu_format = CU_AD_FORMAT_UNSIGNED_INT16_; *channels = 4; *bpp = 8; return TRUE;
+    case DXGI_FORMAT_R16G16B16A16_FLOAT:
+        *cu_format = CU_AD_FORMAT_HALF_; *channels = 4; *bpp = 8; return TRUE;
+    case DXGI_FORMAT_R32G32B32A32_TYPELESS: case DXGI_FORMAT_R32G32B32A32_FLOAT:
+        *cu_format = CU_AD_FORMAT_FLOAT_; *channels = 4; *bpp = 16; return TRUE;
+    case DXGI_FORMAT_R32G32_FLOAT:
+        *cu_format = CU_AD_FORMAT_FLOAT_; *channels = 2; *bpp = 8; return TRUE;
+    case DXGI_FORMAT_R16G16_FLOAT:
+        *cu_format = CU_AD_FORMAT_HALF_; *channels = 2; *bpp = 4; return TRUE;
+    case DXGI_FORMAT_R8G8_UNORM:
+        *cu_format = CU_AD_FORMAT_UNSIGNED_INT8_; *channels = 2; *bpp = 2; return TRUE;
+    case DXGI_FORMAT_R32_FLOAT:
+        *cu_format = CU_AD_FORMAT_FLOAT_; *channels = 1; *bpp = 4; return TRUE;
+    case DXGI_FORMAT_R16_FLOAT:
+        *cu_format = CU_AD_FORMAT_HALF_; *channels = 1; *bpp = 2; return TRUE;
+    case DXGI_FORMAT_R16_UNORM:
+        *cu_format = CU_AD_FORMAT_UNSIGNED_INT16_; *channels = 1; *bpp = 2; return TRUE;
+    case DXGI_FORMAT_R8_UNORM:
+        *cu_format = CU_AD_FORMAT_UNSIGNED_INT8_; *channels = 1; *bpp = 1; return TRUE;
+    case DXGI_FORMAT_R32_UINT: case DXGI_FORMAT_R10G10B10A2_UNORM: case DXGI_FORMAT_R10G10B10A2_UINT:
+        *cu_format = CU_AD_FORMAT_UNSIGNED_INT32_; *channels = 1; *bpp = 4; return TRUE;
+    default:
+        return FALSE;
+    }
+}
+
+static struct d3d11_interop *get_d3d11_interop(CUgraphicsResource resource)
+{
+    struct d3d11_interop *interop;
+
+    LIST_FOR_EACH_ENTRY(interop, &d3d11_interops, struct d3d11_interop, entry)
+        if ((CUgraphicsResource)interop == resource) return interop;
+    return NULL;
+}
+
 CUresult WINAPI wine_cuGraphicsD3D11RegisterResource(CUgraphicsResource *pCudaResource, ID3D11Resource *pD3DResource, unsigned int Flags)
 {
-    ERR("(%p, %p, %u) - Not supported\n", pCudaResource, pD3DResource, Flags);
-    /* Not able to handle spesific flags at this time */
-    if(Flags > 0)
-      return CUDA_ERROR_INVALID_VALUE;
+    D3D11_TEXTURE2D_DESC staging_desc;
+    struct d3d11_interop *interop;
+    ID3D11Multithread *multithread;
+    ID3D11Texture2D *texture;
+    HRESULT hr;
 
-    /* pD3DResource is unknown at this time and cannot be "registered" */
-    return CUDA_ERROR_NOT_SUPPORTED;
+    TRACE("(%p, %p, %#x)\n", pCudaResource, pD3DResource, Flags);
+
+    if (!pCudaResource || !pD3DResource) return CUDA_ERROR_INVALID_VALUE;
+
+    if (FAILED(ID3D11Resource_QueryInterface(pD3DResource, &IID_ID3D11Texture2D, (void **)&texture)))
+    {
