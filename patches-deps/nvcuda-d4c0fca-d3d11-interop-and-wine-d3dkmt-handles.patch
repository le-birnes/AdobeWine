+        ID3D11Texture2D_Release(texture);
+        free(interop);
+        return CUDA_ERROR_INVALID_VALUE;
+    }
+
+    ID3D11Texture2D_GetDevice(texture, &interop->device);
+    /* the copies run on the CUDA thread, the application uses the device on its own threads */
+    if (SUCCEEDED(ID3D11Device_QueryInterface(interop->device, &IID_ID3D11Multithread, (void **)&multithread)))
+    {
+        ID3D11Multithread_SetMultithreadProtected(multithread, TRUE);
+        ID3D11Multithread_Release(multithread);
+    }
+
+    staging_desc = interop->desc;
+    staging_desc.MipLevels = 1;
+    staging_desc.ArraySize = 1;
+    staging_desc.Usage = D3D11_USAGE_STAGING;
+    staging_desc.BindFlags = 0;
+    staging_desc.CPUAccessFlags = D3D11_CPU_ACCESS_READ | D3D11_CPU_ACCESS_WRITE;
+    staging_desc.MiscFlags = 0;
+    if (FAILED(hr = ID3D11Device_CreateTexture2D(interop->device, &staging_desc, NULL, &interop->staging))
+            || !(interop->buffer = malloc((size_t)interop->desc.Width * interop->desc.Height * interop->bpp)))
+    {
+        ERR("Failed to create the staging texture, hr %#lx.\n", hr);
+        if (interop->staging) ID3D11Texture2D_Release(interop->staging);
+        ID3D11Device_Release(interop->device);
+        ID3D11Texture2D_Release(texture);
+        free(interop);
+        return CUDA_ERROR_OUT_OF_MEMORY;
+    }
+    interop->register_flags = Flags;
+
+    EnterCriticalSection(&d3d11_interop_cs);
+    list_add_tail(&d3d11_interops, &interop->entry);
+    LeaveCriticalSection(&d3d11_interop_cs);
+
+    TRACE("Registered %ux%u format %#x as %p.\n", interop->desc.Width, interop->desc.Height, interop->desc.Format, interop);
+    *pCudaResource = (CUgraphicsResource)interop;
+    return CUDA_SUCCESS;
+}
+
+static CUresult d3d11_interop_map(struct d3d11_interop *interop)
+{
+    size_t row = (size_t)interop->desc.Width * interop->bpp;
+    ID3D11DeviceContext *context;
+    D3D11_MAPPED_SUBRESOURCE map;
+    CUDA_MEMCPY2D copy = {0};
+    unsigned int y;
+    CUresult ret;
+
+    if (interop->mapped) return CUDA_ERROR_ALREADY_MAPPED;
+
+    if (!interop->array)
+    {
+        CUDA_ARRAY3D_DESCRIPTOR desc = {0};
+
+        desc.Width = interop->desc.Width;
+        desc.Height = interop->desc.Height;
+        desc.Format = interop->format;
+        desc.NumChannels = interop->channels;
+        if (interop->register_flags & CU_GRAPHICS_REGISTER_FLAGS_SURFACE_LDST_) desc.Flags |= CUDA_ARRAY3D_SURFACE_LDST_;
+        if (interop->register_flags & CU_GRAPHICS_REGISTER_FLAGS_TEXTURE_GATHER_) desc.Flags |= CUDA_ARRAY3D_TEXTURE_GATHER_;
+        if ((ret = wine_cuArray3DCreate_v2(&interop->array, &desc)))
+        {
+            ERR("Failed to create a %ux%u CUDA array, error %d.\n", interop->desc.Width, interop->desc.Height, ret);
+            return ret;
+        }
+    }
+
+    if (!(interop->register_flags & CU_GRAPHICS_REGISTER_FLAGS_WRITE_DISCARD_)
+            && !(interop->map_flags & CU_GRAPHICS_MAP_RESOURCE_FLAGS_WRITE_DISCARD_))
+    {
+        ID3D11Device_GetImmediateContext(interop->device, &context);
+        ID3D11DeviceContext_CopySubresourceRegion(context, (ID3D11Resource *)interop->staging, 0, 0, 0, 0,
+                (ID3D11Resource *)interop->texture, 0, NULL);
+        if (SUCCEEDED(ID3D11DeviceContext_Map(context, (ID3D11Resource *)interop->staging, 0, D3D11_MAP_READ, 0, &map)))
+        {
+            for (y = 0; y < interop->desc.Height; ++y)
+                memcpy(interop->buffer + y * row, (BYTE *)map.pData + (size_t)y * map.RowPitch, row);
+            ID3D11DeviceContext_Unmap(context, (ID3D11Resource *)interop->staging, 0);
+        }
+        ID3D11DeviceContext_Release(context);
+
+        copy.srcMemoryType = CU_MEMORYTYPE_HOST_;
+        copy.srcHost = interop->buffer;
+        copy.srcPitch = row;
+        copy.dstMemoryType = CU_MEMORYTYPE_ARRAY_;
+        copy.dstArray = interop->array;
+        copy.WidthInBytes = row;
+        copy.Height = interop->desc.Height;
+        if ((ret = wine_cuMemcpy2D_v2(&copy))) ERR("Upload to the CUDA array failed, error %d.\n", ret);
+    }
+
+    interop->mapped = TRUE;
+    return CUDA_SUCCESS;
+}
+
+static CUresult d3d11_interop_unmap(struct d3d11_interop *interop, CUstream stream)
+{
+    size_t row = (size_t)interop->desc.Width * interop->bpp;
+    ID3D11DeviceContext *context;
+    CUDA_MEMCPY2D copy = {0};
+    CUresult ret;
+
+    if (!interop->mapped) return CUDA_ERROR_NOT_MAPPED;
+    interop->mapped = FALSE;
+
+    if ((interop->register_flags & CU_GRAPHICS_REGISTER_FLAGS_READ_ONLY_)
+            || (interop->map_flags & CU_GRAPHICS_MAP_RESOURCE_FLAGS_READ_ONLY_))
+        return CUDA_SUCCESS;
+
+    /* work queued on the stream before the unmap writes the array */
+    if (stream) wine_cuStreamSynchronize(stream);
+    else wine_cuCtxSynchronize();
+
+    copy.srcMemoryType = CU_MEMORYTYPE_ARRAY_;
+    copy.srcArray = interop->array;
+    copy.dstMemoryType = CU_MEMORYTYPE_HOST_;
+    copy.dstHost = interop->buffer;
+    copy.dstPitch = row;
+    copy.WidthInBytes = row;
+    copy.Height = interop->desc.Height;
+    if ((ret = wine_cuMemcpy2D_v2(&copy)))
+    {
+        ERR("Download from the CUDA array failed, error %d.\n", ret);
+        return ret;
+    }
+
+    ID3D11Device_GetImmediateContext(interop->device, &context);
+    ID3D11DeviceContext_UpdateSubresource(context, (ID3D11Resource *)interop->texture, 0, NULL, interop->buffer, row, 0);
+    /* other devices (D3D12 through a shared handle) may read the texture next */
+    ID3D11DeviceContext_Flush(context);
+    ID3D11DeviceContext_Release(context);
+    return CUDA_SUCCESS;
+}
+
+/* The functions below return TRUE when every resource in the call is a D3D11 interop resource. */
+
+BOOL d3d11_interop_map_resources(unsigned int count, CUgraphicsResource *resources, CUstream stream, CUresult *ret)
+{
+    struct d3d11_interop *interop;
+    unsigned int i;
+    BOOL handled = FALSE;
+
+    *ret = CUDA_SUCCESS;
+    EnterCriticalSection(&d3d11_interop_cs);
+    for (i = 0; i < count; ++i)
+    {
+        if (!(interop = get_d3d11_interop(resources[i])))
+        {
+            if (handled) FIXME("Mixed D3D11 interop and native resources.\n");
+            break;
+        }
+        handled = TRUE;
+        if ((*ret = d3d11_interop_map(interop))) break;
+    }
+    LeaveCriticalSection(&d3d11_interop_cs);
+    return handled;
+}
+
+BOOL d3d11_interop_unmap_resources(unsigned int count, CUgraphicsResource *resources, CUstream stream, CUresult *ret)
+{
+    struct d3d11_interop *interop;
+    unsigned int i;
+    BOOL handled = FALSE;
+
+    *ret = CUDA_SUCCESS;
+    EnterCriticalSection(&d3d11_interop_cs);
+    for (i = 0; i < count; ++i)
+    {
+        if (!(interop = get_d3d11_interop(resources[i]))) break;
+        handled = TRUE;
+        if ((*ret = d3d11_interop_unmap(interop, stream))) break;
+    }
+    LeaveCriticalSection(&d3d11_interop_cs);
+    return handled;
+}
+
+BOOL d3d11_interop_get_mapped_array(CUarray *array, CUgraphicsResource resource, unsigned int index, unsigned int level, CUresult *ret)
+{
+    struct d3d11_interop *interop;
+
+    EnterCriticalSection(&d3d11_interop_cs);
+    if ((interop = get_d3d11_interop(resource)))
+    {
+        if (!interop->mapped) *ret = CUDA_ERROR_NOT_MAPPED;
+        else if (index || level)
+        {
+            FIXME("Array index %u, mip level %u not supported.\n", index, level);
+            *ret = CUDA_ERROR_INVALID_VALUE;
+        }
+        else
+        {
+            *array = interop->array;
+            *ret = CUDA_SUCCESS;
+        }
+    }
+    LeaveCriticalSection(&d3d11_interop_cs);
+    return interop != NULL;
+}
+
+BOOL d3d11_interop_set_map_flags(CUgraphicsResource resource, unsigned int flags, CUresult *ret)
+{
+    struct d3d11_interop *interop;
+
+    EnterCriticalSection(&d3d11_interop_cs);
+    if ((interop = get_d3d11_interop(resource)))
+    {
+        interop->map_flags = flags;
+        *ret = CUDA_SUCCESS;
+    }
+    LeaveCriticalSection(&d3d11_interop_cs);
+    return interop != NULL;
+}
+
+BOOL d3d11_interop_unregister(CUgraphicsResource resource, CUresult *ret)
+{
+    struct d3d11_interop *interop;
+
+    EnterCriticalSection(&d3d11_interop_cs);
+    if ((interop = get_d3d11_interop(resource))) list_remove(&interop->entry);
+    LeaveCriticalSection(&d3d11_interop_cs);
+    if (!interop) return FALSE;
+
+    if (interop->array) wine_cuArrayDestroy(interop->array);
+    ID3D11Texture2D_Release(interop->staging);
+    ID3D11Texture2D_Release(interop->texture);
+    ID3D11Device_Release(interop->device);
+    free(interop->buffer);
+    free(interop);
+    *ret = CUDA_SUCCESS;
+    return TRUE;
 }
 
