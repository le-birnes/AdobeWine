vkd3d-proton 3.0.1: export memory for shared committed buffers and shared heaps.

Only committed textures with D3D12_HEAP_FLAG_SHARED got exportable memory; CreateSharedHandle() on a shared
buffer then had no handle to give (After Effects shares buffers with CUDA for its composition viewer).
Shared heap allocations now get their own allocation with VkExportMemoryAllocateInfo (OPAQUE_WIN32), the
buffers bound to them VkExternalMemoryBufferCreateInfo, and committed shared buffers open the KMT resource
as committed shared textures do. Win32 builds only. Base: v3.0.1 (3b10bd7a).

diff --git a/libs/vkd3d/memory.c b/libs/vkd3d/memory.c
index ef0bb46..ec6f6a3 100644
--- a/libs/vkd3d/memory.c
+++ b/libs/vkd3d/memory.c
@@ -2142,6 +2142,9 @@ HRESULT vkd3d_allocate_heap_memory(struct d3d12_device *device, struct vkd3d_mem
 {
     struct vkd3d_allocate_heap_memory_info heap_info;
     struct vkd3d_allocate_memory_info alloc_info;
+#ifdef _WIN32
+    VkExportMemoryAllocateInfo export_info;
+#endif
     HRESULT hr;
 
     memset(&alloc_info, 0, sizeof(alloc_info));
@@ -2191,6 +2194,18 @@ HRESULT vkd3d_allocate_heap_memory(struct d3d12_device *device, struct vkd3d_mem
         }
     }
 
+#ifdef _WIN32
+    /* Shared buffers and heaps get their own exportable allocation, as committed shared textures do,
+     * so CreateSharedHandle() works on them (CUDA imports them as D3D12 resources, e.g. After Effects). */
+    if (info->heap_desc.Flags & D3D12_HEAP_FLAG_SHARED)
+    {
+        export_info.sType = VK_STRUCTURE_TYPE_EXPORT_MEMORY_ALLOCATE_INFO;
+        export_info.pNext = NULL;
+        export_info.handleTypes = VK_EXTERNAL_MEMORY_HANDLE_TYPE_OPAQUE_WIN32_BIT;
+        alloc_info.pNext = &export_info;
+    }
+#endif
+
     hr = vkd3d_allocate_memory(device, allocator, &alloc_info, allocation);
 
     if (SUCCEEDED(hr) && (vkd3d_config_flags & VKD3D_CONFIG_FLAG_DEBUG_UTILS) && !allocation->chunk)
diff --git a/libs/vkd3d/resource.c b/libs/vkd3d/resource.c
index 0fa8fb1..ad26ed3 100644
--- a/libs/vkd3d/resource.c
+++ b/libs/vkd3d/resource.c
@@ -202,6 +202,16 @@ HRESULT vkd3d_create_buffer(struct d3d12_device *device,
         external_info.handleTypes = VK_EXTERNAL_MEMORY_HANDLE_TYPE_HOST_ALLOCATION_BIT_EXT;
         buffer_info.pNext = &external_info;
     }
+#ifdef _WIN32
+    else if (heap_flags & D3D12_HEAP_FLAG_SHARED)
+    {
+        /* Bound to exportable memory, see vkd3d_allocate_heap_memory(). */
+        external_info.sType = VK_STRUCTURE_TYPE_EXTERNAL_MEMORY_BUFFER_CREATE_INFO;
+        external_info.pNext = NULL;
+        external_info.handleTypes = VK_EXTERNAL_MEMORY_HANDLE_TYPE_OPAQUE_WIN32_BIT;
+        buffer_info.pNext = &external_info;
+    }
+#endif
 
     if (sparse_resource)
     {
@@ -4380,6 +4390,11 @@ HRESULT d3d12_resource_create_committed(struct d3d12_device *device, const D3D12
 
         object->res.vk_buffer = object->mem.resource.vk_buffer;
         object->res.va = object->mem.resource.va;
+
+#ifdef _WIN32
+        if (heap_flags & D3D12_HEAP_FLAG_SHARED)
+            d3d12_resource_open_export_kmt(object, device, &object->mem);
+#endif
     }
 
     object->priority.allows_dynamic_residency = 
